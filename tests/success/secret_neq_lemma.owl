// secret_neq_lemma(x, w): a value the adversary can compute is not a secret.
// The facts are guarded by the secrecy of the atoms of the other argument.

locality alice

name n : nonce @ alice
name X : DH @ alice
name Y : DH @ alice

def alice_main(x : Data<adv>) @ alice : Unit =
    secret_neq_lemma(x, x ++ get(n) ++ 0x02);
    assert (sec(n) ==> x != x ++ get(n) ++ 0x02);
    secret_neq_lemma(x, dh_combine(dhpk(get(X)), get(Y)));
    assert ((sec(X) /\ sec(Y)) ==> x != dh_combine(dhpk(get(X)), get(Y)));
    // the arguments may be given in either order
    secret_neq_lemma(get(n) ++ 0x03, x);
    assert (sec(n) ==> get(n) ++ 0x03 != x);
    ()

// A gkdf term has type Ghost, but one whose inputs are all public is publicly
// computable, and secret_neq_lemma accepts it as its public argument.

locality alice

name n : nonce @ alice
name X : DH @ alice
name Y : DH @ alice

def alice_main(x : Data<adv>) @ alice : Unit =
    secret_neq_lemma(gkdf<kdfkey; 0>(0x01, x, 0x), x ++ get(n) ++ 0x02);
    secret_neq_lemma(gkdf<kdfkey; 0>(x, 0x02, 0x), dh_combine(dhpk(get(X)), get(Y)));
    assert (sec(n) ==> gkdf<kdfkey; 0>(0x01, x, 0x) != x ++ get(n) ++ 0x02);
    assert ((sec(X) /\ sec(Y)) ==> gkdf<kdfkey; 0>(x, 0x02, 0x) != dh_combine(dhpk(get(X)), get(Y)));
    ()

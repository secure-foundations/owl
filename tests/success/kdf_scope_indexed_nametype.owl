locality alice

kdf_scope G {
    name k : kdfkey @ alice
    nametype Outk<i> = kdfkey

    kdf L_a : k, 0x, 0x01 -> strict Outk<0>
    kdf L_b : k, 0x, 0x02 -> strict Outk<succ(0)>
}

def alice_main() @ alice : Unit =
    corr_case k in
    let k_a = kdf<L_a; kdfkey; 0>(get(k), 0x, 0x01) in
    let k_b = kdf<L_b; kdfkey; 0>(get(k), 0x, 0x02) in
    ()

locality alice

kdf_scope G {

    name A : DH @ alice
    name B : DH @ alice
    name C : DH @ alice
    name D : DH @ alice

    odh L : 0x, dh_ss(A, B) ++ dh_ss(C, D), 0x -> strict enckey Data<adv> |0|

}


def main() @ alice : Option Unit =
    corr_case A in
    corr_case B in
    corr_case C in
    corr_case D in
    // assume(sec(A) /\ sec(B) /\ corr(C) /\ corr(D)); // This is one of the "interesting" cases
    input pk_of_A in
    input pk_of_C in
    guard is_group_elem(pk_of_A) in
    guard is_group_elem(pk_of_C) in
    pcase (pk_of_A == dhpk(get(A))) in
    let pk_of_A : if pk_of_A == dhpk(get(A)) then dhpk(A) else x:Data<adv>{x == pk_of_A} = pk_of_A in
    pcase (pk_of_C == dhpk(get(C))) in
    let pk_of_C : if pk_of_C == dhpk(get(C)) then dhpk(C) else x:Data<adv>{x == pk_of_C} = pk_of_C in
    let k = kdf<L;enckey;0>(0x, dh_combine(pk_of_A, get(B)) ++ dh_combine(pk_of_C, get(D)), 0x) in
    let c = aenc(k, 0x) in
    debug printTyOf(k);
    output c;
    Some(())

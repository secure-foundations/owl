locality alice

name d : nonce @ alice

kdf_scope G {

    name k : kdfkey @ alice
    name f : kdfkey @ alice

    kdf L1 : k, f, 0x -> strict kdfkey
    kdf L2 : KDF<L1;kdfkey;0>, 0x, 0x -> enckey Name(d)

    // name k : kdf {ikm info.
    //     True -> strict kdf {ikm2 info2.
    //         True -> enckey Name(d)
    //     }
    // } @ alice

    // name f : dualkdf {salt info.
    //     True -> strict kdf {ikm2 info2.
    //         True -> enckey Name(d)
    //     }
    // } @ alice   
}


corr [k] /\ [f] ==> [d]

def main() @ alice : (x:Unit{corr(k) /\ corr(f) ==> corr(d)}) = 
    corr_case k in
    corr_case f in
    let k2 = kdf<L1;kdfkey;0>(get(k), get(f), 0x) in 
    let ek = kdf<L2;enckey;0>(k2, 0x, 0x) in 
    let c = aenc(ek, get(d)) in 
    output c




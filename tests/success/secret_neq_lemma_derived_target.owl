// A KDF of public inputs is publicly computable, so it differs from a derived
// name that is secret: the target atom of secret_neq_lemma may be a derived name.

locality alice

kdf_scope G {
    name k : kdfkey @ alice
    kdf L1 : k, 0x01, 0x -> strict kdfkey
    kdf L2 : KDF<L1;kdfkey;0>, 0x01, 0x -> strict kdfkey
}

def alice_main(x : Data<adv>) @ alice : Unit =
    secret_neq_lemma(gkdf<kdfkey; 0>(x, 0x02, 0x), get(KDF<L2;kdfkey;0>));
    assert ((sec(k) /\ sec(KDF<L1;kdfkey;0>) /\ sec(KDF<L2;kdfkey;0>)) ==>
            gkdf<kdfkey; 0>(x, 0x02, 0x) != get(KDF<L2;kdfkey;0>));
    ()

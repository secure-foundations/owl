// Tests: kdf<L<i>; kdfkey; 0> call site

locality alice

kdf_group G {
    name A<i> : DH @ alice
    name B<i> : DH @ alice
    name C1 : kdfkey @ alice

    odh L<i> : C1, dh_combine(A<i>, B<i>), 0x -> strict kdfkey
}

def test<i> () @ alice : SecName(KDF<L<i>; kdfkey; 0>) =
    let salt = get(C1) in
    let ikm = dh_combine(dhpk(get(A<i>)), get(B<i>)) in
    let result = kdf<L<i>; kdfkey; 0>(salt, ikm, 0x) in
    result

// Tests: odh L<n_eph@n,m> where n_eph !=idx n : ...

locality alice
locality bob

kdf_group G {
    name A<@n> : DH @ alice
    name B<@m> : DH @ bob
    nametype C2<@n> : kdfkey
    nametype C3_corr : kdfkey

    odh L_corr<n_eph@n,m> where n_eph !=idx n : C2<@n_eph>, dh_combine(A<@n>, B<@m>), 0x -> strict C3_corr
}

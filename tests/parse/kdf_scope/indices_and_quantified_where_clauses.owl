// Tests kdf rules with predicates on arguments

locality alice: 1

kdf_scope G {
    name A<i@m> : DH @ alice<m>
    name B<i@m> : DH @ alice<m>
    name C1<@m> : kdfkey @ alice<m>

    kdf L3<@m>(ikm) where (forall j:idx. ikm != dhpk(get(A<i@m>))): C1, ikm, 0x ->
        strict kdfkey || public nonce
}


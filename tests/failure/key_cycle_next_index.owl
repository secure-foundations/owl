// Output 1 of L<i> encrypts output 0 of L<succ(i)>.
locality alice
kdf_scope G {
    name k0 : kdfkey @ alice
    rec_kdf<i> L<i>
        | 0        : k0,                              0x, 0x01
        | succ(i') : KDF<L<i'>; kdfkey || enckey; 0>, 0x, 0x01
        -> strict kdfkey || enckey Name(KDF<L<succ(i)>; kdfkey || enckey; 0>)
}
def alice_main() @ alice : Unit = ()

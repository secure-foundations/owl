// The where clause pins x to the PSK, so L1 is applicable through x. A call
// with the same inputs under another hint cannot refute L1 and is rejected.
locality alice

name secretmsg : nonce @ alice

kdf_scope G {
    name k : kdfkey @ alice
    name psk : kdfkey @ alice
    kdf L1(x) where (x == get(psk) \/ x == 0x00) : k, x, 0x -> strict enckey Name(secretmsg)
    kdf L2 : k, 0x, 0x01 -> strict enckey Name(secretmsg)
}

corr adv ==> [k]
corr [psk] ==> [secretmsg]

def alice_main() @ alice : Unit =
    corr_case psk in
    let r1 = kdf<L1(get(psk)); enckey; 0>(get(k), get(psk), 0x) in
    let c = aenc(r1, get(secretmsg)) in
    output c;
    let r2 = kdf<L2; enckey; 0>(get(k), get(psk), 0x) in
    output r2;
    ()

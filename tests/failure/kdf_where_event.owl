// A where clause may not mention an event either: whether happened(..) holds
// depends on the execution, not on the parameters, so the inputs of an
// instance would not determine which derived name it is.
locality alice
name secretmsg : nonce @ alice
def alice_main @ alice
kdf_scope G {
    name k : kdfkey @ alice
    kdf M1 where (happened(alice_main())) : k, 0x, 0x01 -> kdfkey
}
def alice_main() @ alice : Unit = ()

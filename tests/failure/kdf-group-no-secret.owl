locality alice

name n : nonce @ alice

kdf_group G {
    name k : kdfkey @ alice

    // SHOULD FAIL (constraint 1): salt and IKM are all public literals,
    // so no kdfkey from the group appears anywhere, and there is no
    // dh_combine with a local DH key.
    kdf L : 0x, 0x, 0x -> enckey Name(n)
}

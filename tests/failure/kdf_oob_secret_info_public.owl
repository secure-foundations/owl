// No rule matches, but a KDF does not hide its info input, so the output is
// not public.

locality alice

name s : nonce @ alice

kdf_scope G {
    name k : kdfkey @ alice
    kdf L : k, 0x, 0x -> strict kdfkey
}

def leak(m : Data<[s]>) @ alice : Unit =
    let h = kdf<L; kdfkey; 0>(0x, 0x, m) in
    output h

// No rule matches, but the ikm is secret data that is not a key of G, so the
// output is not public.

locality alice

name s : nonce @ alice

kdf_scope G {
    name k : kdfkey @ alice
    kdf L : k, 0x, 0x -> strict kdfkey
}

def leak(m : Data<[s]>) @ alice : Unit =
    let h = kdf<L; kdfkey; 0>(0x, m, 0x) in
    output h

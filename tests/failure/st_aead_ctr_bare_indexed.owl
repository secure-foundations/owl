// A bare nonce clause for an indexed counter is rejected at the declaration.
locality alice

name m<k> : nonce @ alice
counter N<j> @ alice
name mk<k> : st_aead Name(m<k>)
    aad x. true
    nonce N
    @ alice

def send<k,j>() @ alice : Unit =
    let c = st_aead_enc<N<j>>(get(mk<k>), get(m<k>), 0x) in
    output c

// As smt_theory_consistent.owl, for the branch in which k is secret and the
// KDF outputs are derived names. A failure test stops at its first error,
// which in that file is in the corrupt branch. The last assertion here holds
// in the corrupt branch, so it fails only if the secret branch is consistent.

locality alice

name n : nonce @ alice
name K<i> : enckey Data<adv> @ alice

enum E {
    | E1
    | E2 Data<adv>
    | E3
}

kdf_scope G {
    name k : kdfkey @ alice
    kdf L1(x) : k, x, 0x01 -> strict kdfkey || strict enckey Data<adv> || strict mackey Data<adv>
    kdf L2 : KDF<L1(0x);kdfkey||enckey||mackey;0>, 0x, 0x02 -> strict kdfkey || nonce
}

def alice_main<i, j>(x : Data<adv>, y : Data<adv>) @ alice : Unit =
    corr_case k in
    let a0 = kdf<L1(x); kdfkey||enckey||mackey; 0>(get(k), x, 0x01) in
    let a1 = kdf<L1(x); kdfkey||enckey||mackey; 1>(get(k), x, 0x01) in
    let a2 = kdf<L1(x); kdfkey||enckey||mackey; 2>(get(k), x, 0x01) in
    let b0 = kdf<L1(y); kdfkey||enckey||mackey; 0>(get(k), y, 0x01) in
    let c0 = kdf<L1(0x); kdfkey||enckey||mackey; 0>(get(k), 0x, 0x01) in
    let d0 = kdf<L2; kdfkey||nonce; 0>(c0, 0x, 0x02) in
    let d1 = kdf<L2; kdfkey||nonce; 1>(c0, 0x, 0x02) in
    let p0 = kdf<;kdfkey;0>(x, y, 0x) in
    let p1 = kdf<;kdfkey;0>(y, x, 0x) in
    let e = 0x in
    let u = () in
    let t = true in
    let f = false in
    let bx = eq(x, y) in
    let bk = eq(a0, b0) in
    let bp = eq(p0, p1) in
    let bo = eq(a0, a1) in
    let be = eq(e, x) in
    let v1 = E1() in
    let v2 = E2(x) in
    let v3 = E3() in
    let be2 = eq(v1, v3) in
    let kk = eq(get(K<i>), get(K<j>)) in
    assert ([k] <= adv);
    ()

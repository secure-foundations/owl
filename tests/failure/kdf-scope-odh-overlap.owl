locality alice

name n : nonce @ alice
name n2 : nonce @ alice

kdf_scope G {
    name X : DH @ alice
    name Y : DH @ alice

    // SHOULD FAIL: two ODH rules using the same DH pair (X, Y)
    odh L1 : 0x, dh_ss(X, Y), 0x -> enckey Name(n)
    odh L2 : 0x, dh_ss(X, Y), 0x1234 -> enckey Name(n2)
}

// The output type of L<succ(..)> mentions L<0>, which is upstream of it.
locality alice
kdf_scope G {
    name k0 : kdfkey @ alice
    rec_kdf<i> L<i>
        | 0        : k0,                                 0x, 0x01
        | succ(i') : KDF<L<i'>; kdfkey || enckey; 0>,    0x, 0x01
        -> strict kdfkey || enckey Name(KDF<L<0>; kdfkey || enckey; 0>)
}
def alice_main() @ alice : Unit =
    corr_case k0 in
    let c0 = kdf<L<0>; kdfkey || enckey; 0>(get(k0), 0x, 0x01) in
    let ek1 = kdf<L<succ(0)>; kdfkey || enckey; 1>(c0, 0x, 0x01) in
    let c = aenc(ek1, c0) in
    output c to endpoint(alice);
    ()

// k<succ(0),0> would encrypt itself: the second slot does not increase.
locality alice
name k<i, j> : enckey Name(k<succ(j), 0>) @ alice
def alice_main() @ alice : Unit =
    corr_case k<succ(0), 0> in
    let c = aenc(get(k<succ(0), 0>), get(k<succ(0), 0>)) in
    output c to endpoint(alice);
    ()

locality alice

name d : nonce @ alice

kdf_group G {
    name k  : kdfkey @ alice
    name k2 : kdfkey @ alice

    // Rule expects k in the salt position
    kdf L : k, 0x, 0x -> enckey Name(d)
}

def main() @ alice : Unit =
    // SHOULD FAIL: k2 does not match k in the salt position, so
    // kdf<L;enckey;0>(get(k2), 0x, 0x) produces Data<adv>.
    // Using Data<adv> as an encryption key for a secret nonce fails.
    let ek = kdf<L;enckey;0>(get(k2), 0x, 0x) in
    debug printTyOf(ek);
    let c = aenc(ek, get(d)) in
    output c

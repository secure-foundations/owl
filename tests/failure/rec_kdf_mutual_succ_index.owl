locality alice

// SHOULD FAIL: LA's succ case references LB at succ(i) (a larger index).
kdf_scope Bad {
    name k0 : kdfkey @ alice

    rec_kdf<i> LB<i>
        | 0        : k0,                          0x, 0x01
        | succ(i') : KDF<LA<i'>; kdfkey; 0>,      0x, 0x01
        -> strict kdfkey

    rec_kdf<i> LA<i>
        | 0        : KDF<LB<0>; kdfkey; 0>,       0x, 0x02
        | succ(i') : KDF<LB<succ(i)>; kdfkey; 0>, 0x, 0x02
        -> strict kdfkey
}

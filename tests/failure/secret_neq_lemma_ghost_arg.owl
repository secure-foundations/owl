// A forall-bound bitstring has type Ghost, whose label does not flow to adv,
// so it can never be the public argument of secret_neq_lemma. Without that,
// `forall t. sec(n) ==> t != get(n)` would be derivable; instantiated at
// t := get(n) it makes the context inconsistent, which this assert detects.

locality alice

name n : nonce @ alice

def alice_main() @ alice : Unit =
    forall t:bv {
        secret_neq_lemma(t, get(n))
    };
    assert (sec(n) ==> get(n) != get(n));
    ()

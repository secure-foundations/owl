locality alice

// SHOULD FAIL: LB<i> -> LA<i> -> LB<i> at the same index is a cycle
// (LB's succ case references the later rule LA at the current index).
kdf_scope Bad {
    name k0 : kdfkey @ alice

    rec_kdf<i> LB<i>
        | 0        : k0,                     0x, 0x01
        | succ(i') : KDF<LA<i>; kdfkey; 0>,  0x, 0x01
        -> strict kdfkey

    rec_kdf<i> LA<i>
        | 0        : KDF<LB<0>; kdfkey; 0>,  0x, 0x02
        | succ(i') : KDF<LB<i>; kdfkey; 0>,  0x, 0x02
        -> strict kdfkey
}

include "defs.owl"

// Code for the initiator (just the handshake)

// Is eph an ephemeral key for the responder?
predicate is_e_resp(eph) =
    exists m:idx,j:idx.
        eph == dhpk(get(E_resp<j@m>))

// Is eph a static key for the responder?
predicate is_s_resp(eph) =
    exists m:idx.
        eph == dhpk(get(S_resp<@m>))

predicate init_safe<i,n,m>() =
    (sec(S_resp<@m>) /\ sec(E_init<i@n>))
    \/
    (sec(S_resp<@m>) /\ sec(S_init<@n>))

def key_confirm_initiator_send<@n>(k : Ghost) @ Initiator<n> : Unit = ()
def key_confirm_initiator_recv<@n>(k : Ghost) @ Initiator<n> : Unit = ()


// Intermediate state for the initiator, after stage 1 (the first message)
struct init_sent_state<i,n,m> {
    iss_psk : PSKMode<idx n,idx m>,
    iss_static_ss : (x:Ghost{x == dh_combine(dhpk(get(S_init<@n>)),
    get(S_resp<@m>))}),
    ss_h4 : (x:Data<adv> ||crh|| {exists c:bv,ts:bv. x == crh(honest_H4_pre<session i, pid n,pid m>(c, ts))}),
    iss_c3 : if init_safe<i,n,m>[] then
        SecName(KDF<L2<i@n,n,m>; kdfkey||enckey; 0>)
        else
            (x:Data<adv>{x == honest_c3<session i, pid n, pid n, pid m>()})
}

def init_stage1<i@n,m>
    (dhpk_S_resp : dhpk(S_resp<@m>), dhpk_S_init :
    dhpk(S_init<@n>), ss_S_resp_S_init: shared_secret(S_init<@n>, S_resp<@m>),
    psk : PSKMode<idx n,idx m>) @
    Initiator<n> : init_sent_state<session i, pid n, pid m> =
    let C0 = crh(construction()) in
    let H0 = crh(C0 ++ identifier()) in
    let H1 = crh(H0 ++ dhpk_S_resp) in
    let e_init = dhpk(get(E_init<i@n>)) in
    // C1 is publicly computable; no kdf_scope rule needed, use unlabeled kdf
    let C1 = kdf<;kdfkey;0>(C0, e_init, 0x) in
    let H2 = crh(H1 ++ e_init) in
    let ss_S_resp_E_init = dh_combine(dhpk_S_resp, get(E_init<i@n>)) in
    // Derive C2 and k0 via ODH L1 (E_init x S_resp)
    let C2 = kdf<L1<i@n,m>; kdfkey||enckey; 0>(C1, ss_S_resp_E_init, 0x) in
    let k0 = kdf<L1<i@n,m>; kdfkey||enckey; 1>(C1, ss_S_resp_E_init, 0x) in
    let msg1_static
        = st_aead_enc<aead_counter_msg1_C2<i@n>>(k0, dhpk_S_init, H2) in
    let H3 = crh(H2 ++ msg1_static) in
    // Derive C3 and k1 via ODH L2 (S_init x S_resp)
    corr_case S_init<@n> in
    let c3 = kdf<L2<i@n,n,m>; kdfkey || enckey; 0>(C2, ss_S_resp_S_init, 0x) in
    let k1 = kdf<L2<i@n,n,m>; kdfkey || enckey; 1>(C2, ss_S_resp_S_init, 0x) in
    let timestamp = call timestamp_i<@n>() in
    let msg1_timestamp =
        st_aead_enc<aead_counter_msg1_C3<i@n>>(k1, timestamp, H3) in
    let h4 = crh(H3 ++ msg1_timestamp) in

    let msg1_sender : Data<adv> |4| = call get_sender_i<@n>() in
    let msg1_tag = msg1_tag_value() in

    let msg1_mac1_k = crh(mac1() ++ dhpk_S_resp) in
    let msg1_mac1 = mac(msg1_mac1_k,
        msg1_tag ++ msg1_sender ++ e_init ++ msg1_static ++ msg1_timestamp) in
    let msg1_mac2 = zeros_16() in
    let msg1_output = msg1(msg1_tag, msg1_sender, e_init, msg1_static, msg1_timestamp, msg1_mac1, msg1_mac2) in
    output msg1_output;
    init_sent_state<session i, pid n, pid m>(psk, ss_S_resp_S_init, h4, c3)



def init_stage2<i@n,m>
    (st : init_sent_state<session i, pid n, pid m>)
    @
    Initiator<n> : Option (exists j. transp_keys_init<session i, session j, pid n, pid m>) =
    set_option ":rlimit" "7000000" in  // Z3 settings
    parse st as init_sent_state<session i, pid n, pid m>(opsk, static_ss, h4, c3)
    in
    input i in
    pcase
        init_safe<i,n,m>[]
    in
    parse i as msg2(msg2_tag, msg2_sender, msg2_receiver, msg2_ephemeral, msg2_empty_enc, msg2_mac1, msg2_mac2) in
    {
        // This guard is a runtime check
        guard andb(eq(length(msg2_sender), 4), eq(length(msg2_receiver), 4)) in
        guard is_group_elem(msg2_ephemeral) in
        let e_init = get(E_init<i@n>) in
        pcase (exists j:idx. msg2_ephemeral == dhpk(get(E_resp<j@m>))) in 
        choose_idx j | msg2_ephemeral == dhpk(get(E_resp<j@m>)) in

        // the L*_corr hints apply when msg2_ephemeral is not an honest responder ephemeral
        let c4 = kdf<L3<i,j@n,n,m>, L3_corr<i@n,m>(msg2_ephemeral); kdfkey || enckey; 0>(c3, msg2_ephemeral, 0x) in

        let h5 = crh(h4 ++ msg2_ephemeral) in
        let ss = dh_combine(msg2_ephemeral, e_init) in
        cross_dh_lemma<E_init<i@n>>(msg2_ephemeral);
        corr_case E_init<i@n> in
        corr_case E_resp<j@m> in
        let c5 = kdf<L4<i,j@n,n,m>, L4_corr<i@n,m>(msg2_ephemeral); kdfkey; 0>(c4, ss, 0x) in

        // Derive C6 via ODH L5 (S_init x E_resp)
        corr_case S_init<@n> in
        let ss_msg2_eph_s_init = dh_combine(msg2_ephemeral, get(S_init<@n>)) in
        cross_dh_lemma<S_init<@n>>(msg2_ephemeral);
        corr_case KDF<L4<i,j@n,n,m>;kdfkey;0> when !init_safe<i,n,m>[] in
        let c6 = kdf<L5<i,j@n,n,m>, L5_corr<i@n,m>(msg2_ephemeral); kdfkey; 0>(c5, ss_msg2_eph_s_init, 0x) in

        // Derive C7 and tau and k0 from C6 using the PSK.
        let psk : if HasPSK?(opsk) then Name(psk<@n,m>) else ty_zeros_32 =
        case opsk {
                   | HasPSK v => v
                   | NoPSK => zeros_32()
        } in
        pcase HasPSK?(opsk) in
        corr_case KDF<L5<i,j@n,n,m>;kdfkey;0> when !init_safe<i,n,m>[] in
        corr_case psk<@n,m> in
        // L6 in the honest branch; L6_corr in the off-chain branch with a
        // secret PSK. With no PSK, or a corrupt PSK, the call is all public.
        let c7  = kdf<L6<i,j@n,n,m>(psk), L6_corr<i@n,m>(msg2_ephemeral, psk); kdfkey || nonce || enckey; 0>(c6, psk, 0x) in
        let tau = kdf<L6<i,j@n,n,m>(psk), L6_corr<i@n,m>(msg2_ephemeral, psk); kdfkey || nonce || enckey; 1>(c6, psk, 0x) in
        let k0  = kdf<L6<i,j@n,n,m>(psk), L6_corr<i@n,m>(msg2_ephemeral, psk); kdfkey || nonce || enckey; 2>(c6, psk, 0x) in
        let h6 = crh(h5 ++ tau) in
        case st_aead_dec(k0, msg2_empty_enc, h6, 0x)
        as Option (Data<adv>|0|) {
            | None => None()
            | Some x => {
                    forall m':idx,j:idx
                        assuming (exists einit:bv,c:bv,ts:bv,tau:bv. h6 == crh(h6_pre(dhpk(get(S_resp<@m'>)), einit, c, ts, dhpk(get(E_resp<j@m'>)), tau)))
                    {
                        choose_bv einit | exists c:bv,ts:bv,tau:bv. h6 ==
                        crh(h6_pre(dhpk(get(S_resp<@m'>)), einit, c, ts, dhpk(get(E_resp<j@m'>)), tau)) in
                        choose_bv c | exists ts:bv,tau:bv. h6 == crh(h6_pre(dhpk(get(S_resp<@m'>)), einit, c, ts, dhpk(get(E_resp<j@m'>)), tau)) in
                        choose_bv ts | exists tau:bv. h6 == crh(h6_pre(dhpk(get(S_resp<@m'>)), einit, c, ts, dhpk(get(E_resp<j@m'>)), tau)) in
                        choose_bv tau | h6 == crh(h6_pre(dhpk(get(S_resp<@m'>)), einit, c, ts, dhpk(get(E_resp<j@m'>)), tau)) in
                        crh_lemma(h6, crh(h6_pre(dhpk(get(S_resp<@m'>)), einit,
                        c, ts, dhpk(get(E_resp<j@m'>)), tau)));
                        assert (h4 == crh(h4_pre(dhpk(get(S_resp<@m'>)), einit, c, ts)));
                        choose_bv h4_c | exists h4_ts:bv. h4 == crh(honest_H4_pre<session i, pid n, pid m>(h4_c, h4_ts)) in
                        choose_bv h4_ts | h4 == crh(honest_H4_pre<session i, pid n, pid m>(h4_c, h4_ts)) in
                        crh_lemma(crh(h4_pre(dhpk(get(S_resp<@m'>)), einit, c,
                        ts)),
                         crh(honest_H4_pre<session i, pid n, pid m>(h4_c, h4_ts))
                        );
                        assert (m' =idx m);
                        assert (is_e_resp[msg2_ephemeral])
                    };
                    assert(valid_h6[h6] ==>
                        (is_e_resp[msg2_ephemeral]));

                    false_elim in
                    // Derive transport keys from C7 via L7
                    let k1 = kdf<L7<i,j@n,n,m>(psk); enckey || enckey; 0>(c7, 0x, 0x) in
                    let k2 = kdf<L7<i,j@n,n,m>(psk); enckey || enckey; 1>(c7, 0x, 0x) in
                    let _ = call key_confirm_initiator_send<@n>(k1) in
                    let _ = call key_confirm_initiator_recv<@n>(k2) in

                    let tki: exists j. transp_keys_init<session i, session j, pid n, pid m>
                      = pack<j>(transp_keys_init<session i, session j, pid n, pid m>(msg2_receiver, msg2_sender, HasPSK?(opsk), psk, msg2_ephemeral, c7, k1, k2)) in
                    Some(tki)
                }
            otherwise => None()
        }
    }
    otherwise None()

def init_dummy<@n>() @ Initiator<n> : Unit = ()

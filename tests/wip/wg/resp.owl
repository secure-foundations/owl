include "defs.owl"

// Code for the responder (just the handshake)

def key_confirm_responder_send<@m> (k : Ghost) @ Responder<m> : Unit = ()
def key_confirm_responder_recv<@m> (k : Ghost) @ Responder<m> : Unit = ()

// Is eph an ephemeral key for the initiator?
predicate is_e_init(eph) =
    exists n:idx,i:idx.
        eph == dhpk(get(E_init<i@n>))

struct init_info<n, m> {
    init_info_ss : shared_secret(S_init<@n>, S_resp<@m>),
    init_info_psk : PSKMode<idx n,idx m>
}

// This models looking up a public key in the responder's database,
// both to authenticate it and to lookup the precomputed shared secret
def get_pk_info<@m>(pk : Data<adv>) @ Responder<m>
    : Option (exists n.
        (x:init_info<pid n,pid m>{dhpk(get(S_init<@n>)) == pk}))


predicate resp_stage1_clean<j,n_pk, n_eph,m>(eph) =
    (exists i:idx. eph == dhpk(get(E_init<i@n_eph>)))
    /\
    ((sec(S_resp<@m>) /\ sec(S_init<@n_pk>))
     \/
     (exists i:idx. eph == dhpk(get(E_init<i@n_eph>))
        /\
        sec(E_init<i@n_eph>) /\ sec(S_resp<@m>)))

// When the responder's chain keys C5, C6, C7 are secret, for an honest
// ephemeral eph of session i of n_eph: these are the conditions under which
// the kdf call for each matches its hint, rather than having only public
// inputs. They let resp_stage2 give each chain key a conditional type, so
// that the corruption case splits needed for each kdf call stay local to it.
predicate resp_psk_sec<n_pk,m>(haspsk) =
    haspsk == true /\ sec(psk<@n_pk,m>)

predicate resp_c5_sec<i,j,n_pk,n_eph,m>(eph) =
    resp_stage1_clean<j,n_pk,n_eph,m>[eph] \/ (sec(E_init<i@n_eph>) /\ sec(E_resp<j@m>))

predicate resp_c6_sec<i,j,n_pk,n_eph,m>(eph) =
    resp_c5_sec<i,j,n_pk,n_eph,m>[eph] \/ (sec(S_init<@n_pk>) /\ sec(E_resp<j@m>))

predicate resp_c7_sec<i,j,n_pk,n_eph,m>(eph, haspsk) =
    resp_c6_sec<i,j,n_pk,n_eph,m>[eph] \/ resp_psk_sec<n_pk,m>[haspsk]


// Intermediate state for the responder, after stage 1 (the first message).
// n_eph owns the ephemeral key in msg1 (if it is honest), n_pk owns the
// static key decrypted from msg1, i is the session of n_eph.
struct resp_received_state<i,j,n_pk, n_eph, m> {
    rrs_msg1_sender : Data<adv> |4|,
    rrs_psk : PSKMode<idx n_pk, idx m>,
    rrs_dhpk_S_init : dhpk(S_init<@n_pk>),
    rrs_msg1_ephemeral : (x:Data<adv>| |group| |{is_group_elem(x) /\
        (x == dhpk(get(E_init<i@n_eph>)) \/ !is_e_init[x])
    }),
    rrs_c2 : (x:Ghost{
        x ==
        gkdf<kdfkey||enckey; 0>(
            gkdf<kdfkey; 0>(crh(construction()),rrs_msg1_ephemeral, 0x),
            dh_combine(rrs_msg1_ephemeral, get(S_resp<@m>)), 0x)
      }),
    rrs_h4 : (x:Data<adv> | |crh| |{
        exists ts:bv,c:bv.
        x == crh(crh(crh(crh(crh(crh(construction()) ++ identifier()) ++
        dhpk(get(S_resp<@m>))) ++ rrs_msg1_ephemeral) ++ c) ++ ts)
    }),
    // With an honest ephemeral, C3 is the honest chain value for (n_eph, n_pk);
    // otherwise it is public. Written out in full rather than through rrs_c2:
    // KDF injectivity facts do not unfold through a struct projection.
    rrs_c3 : if resp_stage1_clean<j,n_pk,n_eph,m>[rrs_msg1_ephemeral] then
            SecName(KDF<L2<i@n_eph,n_pk,m>; kdfkey||enckey; 0>)
        else
            (x:Data<adv>{x == gkdf<kdfkey||enckey; 0>(
                gkdf<kdfkey||enckey; 0>(
                    gkdf<kdfkey; 0>(crh(construction()), rrs_msg1_ephemeral, 0x),
                    dh_combine(rrs_msg1_ephemeral, get(S_resp<@m>)), 0x),
                dh_combine(dhpk(get(S_init<@n_pk>)), get(S_resp<@m>)), 0x)})
}

def resp_stage1<j@m> (dhpk_S_resp : dhpk(S_resp<@m>)) @ Responder<m>
    : Option (exists n_eph. exists n_pk. exists i. resp_received_state<session i, session j, pid
    n_pk, pid n_eph, pid m> )
    =
     set_option ":rlimit" "2000000" in
input inp in
     parse inp as msg1(msg1_tag, msg1_sender, msg1_ephemeral, msg1_static, msg1_timestamp, msg1_mac1, msg1_mac2) in {
     guard eq(length(msg1_sender), 4) in
     guard is_group_elem(msg1_ephemeral) in
     let C0 = crh(construction()) in
     let H0 = crh(C0 ++ identifier()) in
     let H1 = crh(H0 ++ dhpk_S_resp) in


     // Is the received ephemeral key (msg1_ephemeral) actually an ephemeral
     // key?
     pcase
         (is_e_init[msg1_ephemeral]) in
        // If so, let it be for initiator n and session i of that initiator.
         choose_idx n | exists i:idx. msg1_ephemeral == dhpk(get(E_init<i@n>)) in
         choose_idx i | msg1_ephemeral == dhpk(get(E_init<i@n>)) in
     // C1 is publicly computable; no kdf_scope rule needed, use unlabeled kdf
     let C1 = kdf<;kdfkey;0>(C0, msg1_ephemeral, 0x) in
     let H2 = crh(H1 ++ msg1_ephemeral) in
     let ss_msg1_ephemeral_S_resp = dh_combine(msg1_ephemeral, get(S_resp<@m>)) in

    // cross_dh_lemma states that, given g^x, y, and z, (for random different values x, y,
    // and z), it is hard for the
    // adversary to construct an h such that h^x = g^(y * z) (when x is a
    // secret). If it could do so, we can compute discrete log of x.
    // The actual lemma call is for x = S_resp<@m> and h = msg1_ephemeral, where
    // y and z are the other Diffie-Hellman secrets in the protocol.
     cross_dh_lemma<S_resp<@m>>(msg1_ephemeral);
     // msg1_ephemeral^S_resp != psk: refutes the PSK rules (L6, L6_corr,
     // L6_corr_resp) on the ikm of the C2 call when the ephemeral is forged.
     dh_exp_lemma<S_resp<@m>, psk>(msg1_ephemeral);
     corr_case S_resp<@m> in
     corr_case E_init<i@n> in
     // Derive C2 via ODH L1 (E_init x S_resp). In the branch where
     // msg1_ephemeral is not an honest ephemeral, no rule matches: the
     // checker proves the call out of bounds and the output is public.
     let C2 = kdf<L1<i@n,m>; kdfkey||enckey; 0>(C1, ss_msg1_ephemeral_S_resp, 0x) in
     let k0 = kdf<L1<i@n,m>; kdfkey||enckey; 1>(C1, ss_msg1_ephemeral_S_resp, 0x) in
     case st_aead_dec(k0, msg1_static, H2, 0x) as Option (Data<adv>) {
         | None => None()
         | Some msg1_static_dec =>
                false_elim in
                let oinfo  = call get_pk_info<@m>(msg1_static_dec) in
                case oinfo {
                    | None => None()
                    | Some info =>
                        unpack n3, info = info in
                        parse info as init_info<pid n3, pid m>(ss, psk) in
                        cross_dh_lemma<S_resp<@m>>(msg1_static_dec);
                        let H3 = crh(H2 ++ msg1_static) in
                        let dhpk_S_init : dhpk(S_init<@n3>) = msg1_static_dec in
                        corr_case S_init<@n3> in

                        // Derive C3 via ODH L2 (S_init x S_resp). The rule
                        // carries both initiator indices, so it matches for
                        // any n3 when the ephemeral is honest.
                        let C3 = kdf<L2<i@n,n3,m>; kdfkey || enckey; 0>(C2, ss, 0x) in
                        let k1 = kdf<L2<i@n,n3,m>; kdfkey || enckey; 1>(C2, ss, 0x) in
                        case st_aead_dec(k1, msg1_timestamp, H3, 0x) as Option (Data<adv> |12|) {
                        | None => None()
                        | Some msg1_timestamp_dec =>
                            false_elim in
                            let H4 = crh(H3 ++ msg1_timestamp) in
                            let st : resp_received_state<session i, session j, pid n3, pid n, pid m> =
                                resp_received_state<session i, session j, pid n3, pid n,
                                pid m>(msg1_sender, psk, dhpk_S_init, msg1_ephemeral, C2, H4, C3)
                                in
                            let y = pack<n>(pack<n3>(pack<i>(st))) in
                            Some(y)
                        otherwise => None()
                        }
                }
     otherwise => None()
     }
     }
    otherwise None()


def resp_stage2<j@m> (st : exists n_eph. exists n_pk. exists i. resp_received_state<session i, session j, pid
    n_pk, pid n_eph, pid m>) @ Responder<m> :
     Option (exists n_eph. exists n_pk. exists i.
        transp_keys_resp<session i, session j, pid n_pk, pid n_eph,
        pid m>) =
     set_option ":rlimit" "5000000" in
 unpack n, st' = st in
 unpack n3, st'' = st' in
 unpack i, st''' = st'' in
 parse st''' as resp_received_state<session i, session j, pid n3, pid n, pid
 m>(msg2_receiver, psk, dhpk_S_init, msg1_ephemeral, C2, H4, C3) in
 // This is the only case split over the rest of the def. Every corruption
 // case split below is local to one kdf call: its result gets a conditional
 // type, which later calls split on locally.
 pcase is_e_init[msg1_ephemeral] in
 let e_resp_pk = dhpk(get(E_resp<j@m>)) in
 // Derive C4 from C3 using responder's ephemeral pk (rule L3)
 let c4 = kdf<L3<i,j@n,n3,m>; kdfkey || enckey; 0>(C3, e_resp_pk, 0x) in
 let h5 = crh(H4 ++ e_resp_pk) in
 let ss = dh_combine(msg1_ephemeral, get(E_resp<j@m>)) in
 cross_dh_lemma<E_resp<j@m>>(msg1_ephemeral);
 // The initiator's off-chain rules have a DH ikm with a free base, so they are
 // refuted through their salt: a public chain value is not one of their
 // (secret) salt names.
 forall i':idx, n':idx, m':idx { forall x:bv {
     secret_neq_lemma(c4, get(KDF<L4_corr<i'@n',m'>(x); kdfkey; 0>))
 } };
 // Derive C5 via ODH L4 (E_init x E_resp)
 let c5 : if is_e_init[msg1_ephemeral] then
          (if resp_c5_sec<i,j,n3,n,m>[msg1_ephemeral] then SecName(KDF<L4<i,j@n,n3,m>;kdfkey;0>)
           else (x:Data<adv> ||kdfkey||{x == gkdf<kdfkey;0>(c4, ss, 0x)}))
      else
          (x:Data<adv> ||kdfkey||{x == gkdf<kdfkey;0>(c4, ss, 0x)}) =
    corr_case E_init<i@n> in
    corr_case E_resp<j@m> in
    kdf<L4<i,j@n,n3,m>; kdfkey; 0>(c4, ss, 0x) in
 forall i':idx, n':idx, m':idx { forall x:bv {
     secret_neq_lemma(c5, get(KDF<L3_corr<i'@n',m'>(x); kdfkey||enckey; 0>))
 } };
 // Derive C6 via ODH L5 (S_init x E_resp)
 let ss_s_init_e_resp = dh_combine(dhpk_S_init, get(E_resp<j@m>)) in
 let c6 : if is_e_init[msg1_ephemeral] then
          (if resp_c6_sec<i,j,n3,n,m>[msg1_ephemeral] then SecName(KDF<L5<i,j@n,n3,m>;kdfkey;0>)
           else (x:Data<adv> ||kdfkey||{x == gkdf<kdfkey;0>(c5, ss_s_init_e_resp, 0x)}))
      else
          (x:Data<adv> ||kdfkey||{x == gkdf<kdfkey;0>(c5, ss_s_init_e_resp, 0x)}) =
    corr_case S_init<@n3> in
    corr_case E_resp<j@m> in
    kdf<L5<i,j@n,n3,m>; kdfkey; 0>(c5, ss_s_init_e_resp, 0x) in
 // Derive C7, tau, k0 from C6 using the PSK. L6 in the honest-ephemeral
 // branch; L6_corr_resp in the off-chain branch with a secret PSK. With no
 // PSK, or a corrupt PSK, the off-chain call is all public.
 let psk_val : if HasPSK?(psk) then Name(psk<@n3,m>) else ty_zeros_32 =
 case psk {
            | HasPSK v => v
            | NoPSK => zeros_32()
 } in
 forall i':idx, n':idx, m':idx { forall x:bv {
     secret_neq_lemma(c6, get(KDF<L3_corr<i'@n',m'>(x); kdfkey||enckey; 0>))
 } };
 forall i':idx, n':idx, m':idx { forall x:bv {
     secret_neq_lemma(c6, get(KDF<L4_corr<i'@n',m'>(x); kdfkey; 0>))
 } };
 let c7 : if is_e_init[msg1_ephemeral] then
          (if resp_c7_sec<i,j,n3,n,m>[msg1_ephemeral, HasPSK?(psk)] then SecName(KDF<L6<i,j@n,n3,m>(psk_val);kdfkey||nonce||enckey;0>)
           else (x:Data<adv> ||kdfkey||{x == gkdf<kdfkey||nonce||enckey;0>(c6, psk_val, 0x)}))
      else
          (if resp_psk_sec<n3,m>[HasPSK?(psk)] then SecName(KDF<L6_corr_resp<j@n3,m>(msg1_ephemeral);kdfkey||nonce||enckey;0>)
           else (x:Data<adv> ||kdfkey||{x == gkdf<kdfkey||nonce||enckey;0>(c6, psk_val, 0x)})) =
    corr_case psk<@n3,m> in
    kdf<L6<i,j@n,n3,m>(psk_val), L6_corr_resp<j@n3,m>(msg1_ephemeral); kdfkey || nonce || enckey; 0>(c6, psk_val, 0x) in
 let tau =
    corr_case psk<@n3,m> in
    kdf<L6<i,j@n,n3,m>(psk_val), L6_corr_resp<j@n3,m>(msg1_ephemeral); kdfkey || nonce || enckey; 1>(c6, psk_val, 0x) in
 let k0 : if is_e_init[msg1_ephemeral] then
          (if resp_c7_sec<i,j,n3,n,m>[msg1_ephemeral, HasPSK?(psk)] then SecName(KDF<L6<i,j@n,n3,m>(psk_val);kdfkey||nonce||enckey;2>)
           else (x:Data<adv> ||enckey||{x == gkdf<kdfkey||nonce||enckey;2>(c6, psk_val, 0x)}))
      else
          (if resp_psk_sec<n3,m>[HasPSK?(psk)] then SecName(KDF<L6_corr_resp<j@n3,m>(msg1_ephemeral);kdfkey||nonce||enckey;2>)
           else (x:Data<adv> ||enckey||{x == gkdf<kdfkey||nonce||enckey;2>(c6, psk_val, 0x)})) =
    corr_case psk<@n3,m> in
    kdf<L6<i,j@n,n3,m>(psk_val), L6_corr_resp<j@n3,m>(msg1_ephemeral); kdfkey || nonce || enckey; 2>(c6, psk_val, 0x) in
 let msg2_tag = msg2_tag_value() in
 let msg2_sender : Data<adv> |4| = call get_sender_r<@m>() in
 let msg2_mac1_k = crh(mac1() ++ dhpk_S_init) in
 let h6 = crh(h5 ++ tau) in
 forall i':idx, n':idx, m':idx { forall x:bv {
     secret_neq_lemma(c7, get(KDF<L3_corr<i'@n',m'>(x); kdfkey||enckey; 0>))
 } };
 forall i':idx, n':idx, m':idx { forall x:bv {
     secret_neq_lemma(c7, get(KDF<L4_corr<i'@n',m'>(x); kdfkey; 0>))
 } };
 forall i':idx, n':idx, m':idx { forall x:bv {
     secret_neq_lemma(c7, get(KDF<L5_corr<i'@n',m'>(x); kdfkey; 0>))
 } };
 // Derive transport keys from C7 via L7 / L7_corr_resp
 let tk1 = kdf<L7<i,j@n,n3,m>(psk_val), L7_corr_resp<j@n3,m>(msg1_ephemeral); enckey || enckey; 0>(c7, 0x, 0x) in
 let tk2 = kdf<L7<i,j@n,n3,m>(psk_val), L7_corr_resp<j@n3,m>(msg1_ephemeral); enckey || enckey; 1>(c7, 0x, 0x) in
 let _ = call key_confirm_responder_recv<@m>(tk1) in
 let _ = call key_confirm_responder_send<@m>(tk2) in
 assert (valid_h6[h6]);
 assert (tk1 == tk1_of_c6(c6, psk_val));
 assert (happened(key_confirm_responder_recv<@m>(tk1_of_c6(c6, psk_val))));
 let msg2_empty : Data<adv> | cipherlen(0) | = st_aead_enc<aead_counter_msg2_C7<j@m>>(k0, 0x, h6) in
 let msg2_mac1 = mac(msg2_mac1_k,
         msg2_tag ++ msg2_sender ++ msg2_receiver ++ e_resp_pk ++
         msg2_empty) in
 let msg2_mac2 = zeros_16() in
 let msg2_output: msg2 = msg2(
     msg2_tag, msg2_sender, msg2_receiver, e_resp_pk, msg2_empty, msg2_mac1, msg2_mac2
 ) in
 let _ = output msg2_output in
 let ret =
 pack<n>(
     pack<n3>(
     pack<i>(
     transp_keys_resp<session i, session j, pid n3, pid n, pid
     m>(msg2_receiver, msg2_sender, HasPSK?(psk), psk_val, msg1_ephemeral, c7, false, tk1, tk2))))
 in
 Some(ret)



def resp_dummy<@m>() @ Responder<m> : Unit = ()

/*

Signal double ratchet for the libsignal integration, one message per
direction per round (lockstep). Declarations are in defs.owl; the handshake
is PQXDH (pqxdh.owl), which calls bob_step_0 below. Derived from
tests/wip/signal/x3dh_double_ratchet/double_ratchet.owl; the security statements are the same.

In round i, Bob sends, then Alice replies (because Alice's first
message was sent in X3DH). Each message takes one DH ratchet
step, combining the sender's fresh key with the peer's current one:

    Bob,   round i : rk_B<i> || kb<i> = kdf(rk_A<i-1>, dh(a<i>,   b<i>), "WhisperRatchet")   (rule LB<i>)
    Alice, round i : rk_A<i> || ka<i> = kdf(rk_B<i>,   dh(a<i+1>, b<i>), "WhisperRatchet")   (rule LA<i>)

with rk_A<-1> = RK_1 = KDF<LA_init(kss); ..; 0>, the X3DH root key; a<0> is
Alice's X3DH ratchet key. kss is the KEM shared secret of the handshake
(PQXDH): every rule of the chain takes it as a parameter, and every def and
state carries it as a ghost.

Defs. A receive def decrypts the peer's message, recomputes the peer's step,
and takes its own step with a fresh key (libsignal's dh_ratchet_step, which
does both root steps when a message carries a new ratchet key). A send def
encrypts under the resulting chain key. bob_step_0 is Bob's first step.

State. The defs are state transformers, and none of them calls another: an
application drives the rounds (see defs.owl). A send def's plaintext is
secret only if the sender holds the honest chain key and that key is secret.
Owl does not check the application: it must pass each returned state and key
to the def of the next round, in order, and generate every fresh ratchet key.

Proven (each site is marked PROVEN [Pn] below):
  - [P1] Secrecy of mb<i> and ma<i> (the st_aead_enc in each send def).
  - [P2] Post-compromise security (locally in the recovery case):
    after a root key was corrupted, a step whose two DH keys are secret
    gives a secret root key again (alice_recv_succ, bob_recv_1,
    bob_recv_succ).
  - [P3] Agreement and key authenticity (the asserts after each receive
    def's decryption): under a secret incoming root key, the
    receiver asserts the peer's sent event and gets the peer's honest
    ratchet key.

Assumed: no skipped or out-of-order messages, one message per chain. The
identity keys in the AADs come from the identity store.

*/

include "defs.owl"

// ------------ EVENTS ------------

def bob_sent<i>(x : Ghost) @ bob : Unit = ()
def alice_sent<i>(x : Ghost) @ alice : Unit = ()

// ------------ ROUND 0 ------------

// Bob's first ratchet step, called by bob_recv_prekey (parameters: see
// defs.owl). He holds his X3DH root key and Alice's X3DH ratchet key.
def bob_step_0(
  kss: Ghost,
  bpre: (x:Ghost{ length(x) == length(x3dh_dh()) }),
  bdh: (x:Ghost{ x == bpre ++ kss }),
  bm: (x:Ghost{ x == gkdf<kdfkey || kdfkey; 0>(0x, bdh,
          0x57686973706572546578745f5832353531395f5348412d3235365f4352595354414c532d4b594245522d31303234) }),
  rb_g: Ghost,
  gae: (x:Data<adv> ||group||{
          (rb_g == get(KDF<LA_init(kss); kdfkey || enckey; 0>) /\ sec(KDF<LA_init(kss); kdfkey || enckey; 0>))
            ==> x == dhpk(get(a<0>)) }),
  rb: if rb_g == get(KDF<LA_init(kss); kdfkey || enckey; 0>) /\ sec(KDF<LA_init(kss); kdfkey || enckey; 0>)
      then Name(KDF<LA_init(kss); kdfkey || enckey; 0>)
      else (x:Data<adv> ||kdfkey||{ x == rb_g /\ x == gkdf<kdfkey || enckey; 0>(bm, dh_combine(gae, get(bs)), 0x5768697370657252617463686574) }),
  a3: dhpk(long_skA),
  bk0: Name(b<0>),
  ka_g: Ghost,
  ka: if ka_g == get(KDF<LA_init(kss); kdfkey || enckey; 1>) then Name(KDF<LA_init(kss); kdfkey || enckey; 1>)
      else Data<adv> ||enckey||,
  pt: Data<adv /\ [ma1], |adv|>
) @ bob: Option bob_prekey_out =
  guard is_group_elem(gae) in
  pcase sec(KDF<LA_init(kss); kdfkey || enckey; 0>) in
  // rb may be RK_1 even when it is public.
  pcase rb_g == get(KDF<LA_init(kss); kdfkey || enckey; 0>) in
  pcase sec(b<0>) in
  // The label of a chain name follows the applicability of its rule instance.
  kdf_label_lemma<KDF<LB<0>(kss); kdfkey || enckey; 0>>();
  false_elim in

  let gae': if (gae == dhpk(get(a<0>))) then dhpk(a<0>) else (x:Data<adv> ||group||{x == gae}) = gae in
  cross_dh_lemma<b<0>>(gae');
  // rb is RK_1 or public: it is not a secret chain name of any step.
  forall k:bv { secret_neq_lemma(rb, get(KDF<LA_init(k); kdfkey || enckey; 0>)) };
  forall j:idx { forall k:bv { secret_neq_lemma(rb, get(KDF<LA<j>(k); kdfkey || enckey; 0>)) } };
  forall j:idx { forall k:bv { secret_neq_lemma(rb, get(KDF<LB<j>(k); kdfkey || enckey; 0>)) } };
  false_elim in
  let s = dh_combine(gae', bk0) in
  // s is not a KEM secret (for the parameter of LB_bad)
  forall j:idx { dh_exp_lemma<b<0>, KEMName<pqbo, j>>(gae) };
  let rb' = kdf<LB<0>(kss), LB_bad<0>(s, kss); kdfkey || enckey; 0>(rb, s, 0x5768697370657252617463686574) in
  let kb  = kdf<LB<0>(kss), LB_bad<0>(s, kss); kdfkey || enckey; 1>(rb, s, 0x5768697370657252617463686574) in
  // PROVENANCE: rb' is Bob's state for bob_recv_1.
  // CHAIN KEY: kb is the key for bob_send<0> (kb_g := kb).
  Some(bob_prekey_out(bob_state_1(kss, gae', rb, rb', rb', bk0, a3), kss, kb, kb, pt, ka, ka))

// Alice receives Bob's round-0 message and performs her round-0 step.
// ra is Alice's X3DH root key (parameters: her alice_init_state).
//   ak0 : her ratchet key a<0>;  ak1 : her fresh ratchet key a<succ(0)>.
def alice_recv_0(
  kss: Ghost,
  apre: (x:Ghost{ length(x) == length(x3dh_dh()) }),
  adh: (x:Ghost{ x == apre ++ kss }),
  am: (x:Ghost{ x == gkdf<kdfkey || kdfkey; 0>(0x, adh,
          0x57686973706572546578745f5832353531395f5348412d3235365f4352595354414c532d4b594245522d31303234) }),
  ags: Ghost,
  ra_g: Ghost,
  ra_y: Ghost,
  ra: if ra_g == get(KDF<LA_init(kss); kdfkey || enckey; 0>) then Name(KDF<LA_init(kss); kdfkey || enckey; 0>)
      else if is_group_elem(ra_y) /\ ra_y != dhpk(get(bo))
              /\ ra_g == get(KDF<LA_init_badA(ra_y, kss); kdfkey || enckey; 0>)
      then Name(KDF<LA_init_badA(ra_y, kss); kdfkey || enckey; 0>)
      else (x:Data<adv> ||kdfkey||{ x == ra_g /\ x == gkdf<kdfkey || enckey; 0>(am, dh_combine(ags, get(a<0>)), 0x5768697370657252617463686574) }),
  ak0: Name(a<0>),
  ak1: Name(a<succ(0)>),
  b3: dhpk(long_skB),
  ika: dhpk(long_skA)
) @ alice: Option alice_recv_out<0> =
  input i2, _ in
  parse i2 as signal_message(gbe, ctr, prev, ctxt, addr) in {
    guard is_group_elem(gbe) in
    pcase sec(KDF<LA_init(kss); kdfkey || enckey; 0>) in
    // ra may be RK_1 even when it is public.
    pcase ra_g == get(KDF<LA_init(kss); kdfkey || enckey; 0>) in
    pcase sec(a<0>) in
    pcase sec(b<0>) in
    pcase gbe == dhpk(get(b<0>)) in
    cross_dh_lemma<a<0>>(gbe);
    kdf_label_lemma<KDF<LB<0>(kss); kdfkey || enckey; 0>>();
    kdf_label_lemma<KDF<LA<0>(kss); kdfkey || enckey; 0>>();
    false_elim in

    // ra is public or a chain name: it is not a secret chain name of another step.
    forall k:bv { secret_neq_lemma(ra, get(KDF<LA_init(k); kdfkey || enckey; 0>)) };
    forall j:idx { forall k:bv { secret_neq_lemma(ra, get(KDF<LA<j>(k); kdfkey || enckey; 0>)) } };
    forall j:idx { forall k:bv { secret_neq_lemma(ra, get(KDF<LB<j>(k); kdfkey || enckey; 0>)) } };
    // Bob's step of round 0, recomputed by Alice
    let s_b = dh_combine<name b<0>, name a<0>>(gbe, ak0) in
    // s_b is not a KEM secret (for the parameter of the _bad rule)
    forall j:idx { dh_exp_lemma<a<0>, KEMName<pqbo, j>>(gbe) };
    let rb' = kdf<LB<0>(kss), LB_bad<0>(s_b, kss); kdfkey || enckey; 0>(ra, s_b, 0x5768697370657252617463686574) in
    let kb  = kdf<LB<0>(kss), LB_bad<0>(s_b, kss); kdfkey || enckey; 1>(ra, s_b, 0x5768697370657252617463686574) in

    let N_c = get_counter N_c_alice in
    let mb_opt = st_aead_dec(kb, ctxt, b3 ++ ika ++ gbe ++ ctr ++ prev ++ addr, N_c) in
    case mb_opt {
      | None => None()
      | Some m => {
        // PROVEN [P3]: agreement and key authenticity. With the honest, secret
        // root key RK_1, the decrypted message was sent by Bob in round 0 and
        // the received ratchet key is his honest b<0>.
        assert ((ra_g == get(KDF<LA_init(kss); kdfkey || enckey; 0>) /\ sec(KDF<LA_init(kss); kdfkey || enckey; 0>))
                ==> (happened(bob_sent<0>(m)) /\ gbe == dhpk(get(b<0>))));
        // Alice's step of round 0: fresh a<succ(0)> against Bob's b<0>
        pcase sec(a<succ(0)>) in
        cross_dh_lemma<a<succ(0)>>(gbe);
        false_elim in
        // rb' is public or a chain name: it is not a secret chain name of another step.
        forall j:idx { forall k:bv { secret_neq_lemma(rb', get(KDF<LA<j>(k); kdfkey || enckey; 0>)) } };
        forall j:idx { forall k:bv { secret_neq_lemma(rb', get(KDF<LB<j>(k); kdfkey || enckey; 0>)) } };
        let s_a = dh_combine<name b<0>, name a<succ(0)>>(gbe, ak1) in
        // s_a is not a KEM secret (for the parameter of the _bad rule)
        forall j:idx { dh_exp_lemma<a<succ(0)>, KEMName<pqbo, j>>(gbe) };
        let ra' = kdf<LA<0>(kss), LA_bad<0>(s_a, kss); kdfkey || enckey; 0>(rb', s_a, 0x5768697370657252617463686574) in
        let ka  = kdf<LA<0>(kss), LA_bad<0>(s_a, kss); kdfkey || enckey; 1>(rb', s_a, 0x5768697370657252617463686574) in
        // PROVENANCE: ra' is Alice's state for alice_recv_succ<0>
        // (wpk := gbe, wsalt2 := ra, ra_g := ra', wsalt := rb', ak := ak1).
        // CHAIN KEY: ka is the key for alice_send<0> (ka_g := ka).
        Some(alice_recv_out<0>(alice_state<0>(kss, gbe, ra, ra', rb', ra', ak1, b3), kss, ka, ka, m, kb, kb))
      }
    }
  } otherwise None()

// ------------ SEND ------------

// Alice sends her round-i message under the chain key of her LA<i> step,
// with her ratchet key a<succ(i)> (its public key, from her state). The plaintext is
// secret only in the good state, when she holds the honest chain key and it
// is secret; otherwise it is public.
def alice_send<i>(
  kss: Ghost,
  ka_g: Ghost,
  ka: if ka_g == get(KDF<LA<i>(kss); kdfkey || enckey; 1>) then Name(KDF<LA<i>(kss); kdfkey || enckey; 1>)
      else Data<adv> ||enckey||,
  apk: dhpk(a<succ(i)>), // her ratchet key (public)
  ika: dhpk(long_skA),
  b3: if ka_g == get(KDF<LA<i>(kss); kdfkey || enckey; 1>) then dhpk(long_skB) else Data<adv> ||group||,
  pt: if ka_g == get(KDF<LA<i>(kss); kdfkey || enckey; 1>) /\ sec(KDF<LA<i>(kss); kdfkey || enckey; 1>) then Name(ma<i>) else Data<adv>
) @ alice: Unit =
  call alice_sent<i>(pt);
  // PROVEN [P1]: pt is Name(ma<i>) only under the honest, secret key.
  let x = st_aead_enc<N_c_alice>(ka, pt, ika ++ b3 ++ apk ++ 0x00000000000000000000000000000000) in
  let msg = signal_message(apk, 0x0000000000000000, 0x0000000000000000, x, 0x) in
  let _ = output msg to endpoint(bob) in
  ()

// Bob sends his round-i message under the chain key of his LB<i> step, with
// his ratchet key b<i> (its public key, from his state).
def bob_send<i>(
  kss: Ghost,
  kb_g: Ghost,
  kb: if kb_g == get(KDF<LB<i>(kss); kdfkey || enckey; 1>) then Name(KDF<LB<i>(kss); kdfkey || enckey; 1>)
      else Data<adv> ||enckey||,
  bpk: dhpk(b<i>),       // his ratchet key (public)
  ikb: dhpk(long_skB),
  a3: if kb_g == get(KDF<LB<i>(kss); kdfkey || enckey; 1>) then dhpk(long_skA) else Data<adv> ||group||,
  pt: if kb_g == get(KDF<LB<i>(kss); kdfkey || enckey; 1>) /\ sec(KDF<LB<i>(kss); kdfkey || enckey; 1>) then Name(mb<i>) else Data<adv>
) @ bob: Unit =
  call bob_sent<i>(pt);
  // PROVEN [P1]: pt is Name(mb<i>) only under the honest, secret key.
  let x = st_aead_enc<N_c_bob>(kb, pt, ikb ++ a3 ++ bpk ++ 0x00000000000000000000000000000000) in
  let msg = signal_message(bpk, 0x0000000000000000, 0x0000000000000000, x, 0x) in
  let _ = output msg to endpoint(alice) in
  ()

// ------------ GENERIC STEP (round succ(i)) ------------

// Bob receives Alice's round-0 message and performs his round-1 step.
// He holds the root key after his own round-0 step.
//   bk1 : his fresh ratchet key b<succ(0)>.
def bob_recv_1(st: bob_state_1, bk1: Name(b<succ(0)>), ikb: dhpk(long_skB)) @ bob: Option bob_recv_out<0> =
  // PROVENANCE: Bob's root key is his LB<0> step over the root key wsalt
  // and the share wpk he used in bob_step_0.
  parse st as bob_state_1(kss, wpk, wsalt, rb_g, rb0, bk0, a3) in
  // Restate rb's provenance over the local names: KDF injectivity facts do
  // not unfold through the struct projections of the parsed field types.
  let rb : (if rb_g == get(KDF<LB<0>(kss); kdfkey || enckey; 0>) then Name(KDF<LB<0>(kss); kdfkey || enckey; 0>)
            else (x:Data<adv> ||kdfkey||
                  { x == rb_g /\ x == gkdf<kdfkey || enckey; 0>(wsalt, dh_combine(wpk, get(b<0>)), 0x5768697370657252617463686574)
                    /\ no_chain_b<0>[x] })) = rb0 in
  input i2, _ in
  parse i2 as signal_message(gae, ctr, prev, ctxt, addr) in {
    guard is_group_elem(gae) in
    pcase chain_b<0>[kss] in
    pcase sec(a<succ(0)>) in
    pcase sec(b<0>) in
    pcase sec(b<succ(0)>) in
    pcase gae == dhpk(get(a<succ(0)>)) in
    // PROVENANCE: does Bob hold the honest chain name?
    pcase rb_g == get(KDF<LB<0>(kss); kdfkey || enckey; 0>) in
    cross_dh_lemma<b<0>>(gae);
    cross_dh_lemma<b<0>>(wpk);
    kdf_label_lemma<KDF<LB<0>(kss); kdfkey || enckey; 0>>();
    kdf_label_lemma<KDF<LA<0>(kss); kdfkey || enckey; 0>>();
    kdf_label_lemma<KDF<LB<succ(0)>(kss); kdfkey || enckey; 0>>();
    false_elim in

    // rb is public or a chain name: it is not a secret chain name of another step.
    forall j:idx { forall k:bv { secret_neq_lemma(rb, get(KDF<LA<j>(k); kdfkey || enckey; 0>)) } };
    forall j:idx { forall k:bv { secret_neq_lemma(rb, get(KDF<LB<j>(k); kdfkey || enckey; 0>)) } };
    // Alice's step of round 0, recomputed by Bob
    let s_a = dh_combine<name a<succ(0)>, name b<0>>(gae, bk0) in
    // s_a is not a KEM secret (for the parameter of the _bad rule)
    forall j:idx { dh_exp_lemma<b<0>, KEMName<pqbo, j>>(gae) };
    let ra' = kdf<LA<0>(kss), LA_bad<0>(s_a, kss); kdfkey || enckey; 0>(rb, s_a, 0x5768697370657252617463686574) in
    let ka  = kdf<LA<0>(kss), LA_bad<0>(s_a, kss); kdfkey || enckey; 1>(rb, s_a, 0x5768697370657252617463686574) in

    let N_c = get_counter N_c_bob in
    let ma_opt = st_aead_dec(ka, ctxt, a3 ++ ikb ++ gae ++ ctr ++ prev ++ addr, N_c) in
    case ma_opt {
      | None => None()
      | Some m => {
        // PROVEN [P3]: agreement and key authenticity under a secret incoming root key
        assert ((rb_g == get(KDF<LB<0>(kss); kdfkey || enckey; 0>) /\ chain_b<0>[kss]) ==> happened(alice_sent<0>(m)));
        assert ((rb_g == get(KDF<LB<0>(kss); kdfkey || enckey; 0>) /\ chain_b<0>[kss]) ==> gae == dhpk(get(a<succ(0)>)));
        // Bob's step of round 1: fresh b<succ(0)> against a<succ(0)>
        cross_dh_lemma<b<succ(0)>>(gae);
        false_elim in
        // ra' is public or a chain name: it is not a secret chain name of another step.
        forall j:idx { forall k:bv { secret_neq_lemma(ra', get(KDF<LA<j>(k); kdfkey || enckey; 0>)) } };
        forall j:idx { forall k:bv { secret_neq_lemma(ra', get(KDF<LB<j>(k); kdfkey || enckey; 0>)) } };
        let s_b = dh_combine<name a<succ(0)>, name b<succ(0)>>(gae, bk1) in
        // s_b is not a KEM secret (for the parameter of the _bad rule)
        forall j:idx { dh_exp_lemma<b<succ(0)>, KEMName<pqbo, j>>(gae) };
        let rb' = kdf<LB<succ(0)>(kss), LB_bad<succ(0)>(s_b, kss); kdfkey || enckey; 0>(ra', s_b, 0x5768697370657252617463686574) in
        let kb  = kdf<LB<succ(0)>(kss), LB_bad<succ(0)>(s_b, kss); kdfkey || enckey; 1>(ra', s_b, 0x5768697370657252617463686574) in
        // PROVEN [P2]: if Bob's incoming root key is corrupt but both DH keys
        // of Alice's step LA<0> are secret, his next root key is secret again.
        assert(
          !chain_b<0>[kss]
          /\ (sec(a<succ(0)>) /\ sec(b<0>))
            ==> chain_b<succ(0)>[kss]
        );

        // PROVENANCE: rb' is Bob's state for bob_recv_succ<0>
        // (wpk := gae, wsalt2 := rb, rb_g := rb', wsalt := ra', bk := bk1).
        // CHAIN KEY: kb is the key for bob_send<succ(0)> (kb_g := kb).
        Some(bob_recv_out<0>(bob_state<0>(kss, gae, rb, rb', ra', rb', bk1, a3), kss, kb, kb, m, ka, ka))
      }
    }
  } otherwise None()

// Bob receives Alice's round-succ(i) message and performs his
// round-succ(succ(i)) step. He holds the root key after his own
// round-succ(i) step. (A rule hint at a bare index variable selects no case,
// so the generic step is written one round up.)
//   bk2 : his fresh ratchet key b<succ(succ(i))>.
def bob_recv_succ<i>(st: bob_state<idx i>, bk2: Name(b<succ(succ(i))>), ikb: dhpk(long_skB)) @ bob: Option bob_recv_out<succ(i)> =
  // PROVENANCE, two levels: Bob's root key is his LB<succ(i)> step over his
  // recomputation of Alice's LA<i> step, both against the share wpk received
  // in the previous receive def.
  parse st as bob_state<idx i>(kss, wpk, wsalt2, rb_g, wsalt, rb, bk1, a3) in
  input i2, _ in
  parse i2 as signal_message(gae, ctr, prev, ctxt, addr) in {
    guard is_group_elem(gae) in
    pcase chain_b<succ(i)>[kss] in
    pcase sec(a<succ(succ(i))>) in
    pcase sec(b<succ(i)>) in
    pcase sec(b<succ(succ(i))>) in
    pcase gae == dhpk(get(a<succ(succ(i))>)) in
    // PROVENANCE: does Bob hold the honest chain name?
    pcase rb_g == get(KDF<LB<succ(i)>(kss); kdfkey || enckey; 0>) in
    cross_dh_lemma<b<succ(i)>>(gae);
    cross_dh_lemma<b<succ(i)>>(wpk);
    kdf_label_lemma<KDF<LA<i>(kss); kdfkey || enckey; 0>>();
    kdf_label_lemma<KDF<LB<succ(i)>(kss); kdfkey || enckey; 0>>();
    kdf_label_lemma<KDF<LA<succ(i)>(kss); kdfkey || enckey; 0>>();
    kdf_label_lemma<KDF<LB<succ(succ(i))>(kss); kdfkey || enckey; 0>>();
    false_elim in

    // rb is public or a chain name: it is not a secret chain name of another step.
    forall j:idx { forall k:bv { secret_neq_lemma(rb, get(KDF<LA<j>(k); kdfkey || enckey; 0>)) } };
    forall j:idx { forall k:bv { secret_neq_lemma(rb, get(KDF<LB<j>(k); kdfkey || enckey; 0>)) } };
    // Alice's step of round succ(i), recomputed by Bob
    let s_a = dh_combine<name a<succ(succ(i))>, name b<succ(i)>>(gae, bk1) in
    // s_a is not a KEM secret (for the parameter of the _bad rule)
    forall j:idx { dh_exp_lemma<b<succ(i)>, KEMName<pqbo, j>>(gae) };
    let ra' = kdf<LA<succ(i)>(kss), LA_bad<succ(i)>(s_a, kss); kdfkey || enckey; 0>(rb, s_a, 0x5768697370657252617463686574) in
    let ka  = kdf<LA<succ(i)>(kss), LA_bad<succ(i)>(s_a, kss); kdfkey || enckey; 1>(rb, s_a, 0x5768697370657252617463686574) in

    let N_c = get_counter N_c_bob in
    let ma_opt = st_aead_dec(ka, ctxt, a3 ++ ikb ++ gae ++ ctr ++ prev ++ addr, N_c) in
    case ma_opt {
      | None => None()
      | Some m => {
        // PROVEN [P3]: agreement and key authenticity under a secret incoming root key
        assert ((rb_g == get(KDF<LB<succ(i)>(kss); kdfkey || enckey; 0>) /\ chain_b<succ(i)>[kss]) ==> happened(alice_sent<succ(i)>(m)));
        assert ((rb_g == get(KDF<LB<succ(i)>(kss); kdfkey || enckey; 0>) /\ chain_b<succ(i)>[kss]) ==> gae == dhpk(get(a<succ(succ(i))>)));
        // Bob's step of round succ(succ(i)): fresh b<succ(succ(i))> against a<succ(succ(i))>
        cross_dh_lemma<b<succ(succ(i))>>(gae);
        false_elim in
        // ra' is public or a chain name: it is not a secret chain name of another step.
        forall j:idx { forall k:bv { secret_neq_lemma(ra', get(KDF<LA<j>(k); kdfkey || enckey; 0>)) } };
        forall j:idx { forall k:bv { secret_neq_lemma(ra', get(KDF<LB<j>(k); kdfkey || enckey; 0>)) } };
        let s_b = dh_combine<name a<succ(succ(i))>, name b<succ(succ(i))>>(gae, bk2) in
        // s_b is not a KEM secret (for the parameter of the _bad rule)
        forall j:idx { dh_exp_lemma<b<succ(succ(i))>, KEMName<pqbo, j>>(gae) };
        let rb' = kdf<LB<succ(succ(i))>(kss), LB_bad<succ(succ(i))>(s_b, kss); kdfkey || enckey; 0>(ra', s_b, 0x5768697370657252617463686574) in
        let kb  = kdf<LB<succ(succ(i))>(kss), LB_bad<succ(succ(i))>(s_b, kss); kdfkey || enckey; 1>(ra', s_b, 0x5768697370657252617463686574) in
        // PROVEN [P2]: if Bob's incoming root key is corrupt but both DH keys
        // of Alice's step LA<succ(i)> are secret, his next root key is secret again.
        assert(
          !chain_b<succ(i)>[kss]
          /\ (sec(a<succ(succ(i))>) /\ sec(b<succ(i)>))
            ==> chain_b<succ(succ(i))>[kss]
        );

        // PROVENANCE: rb' is Bob's state for bob_recv_succ<succ(i)>
        // (wpk := gae, wsalt2 := rb, rb_g := rb', wsalt := ra', bk := bk2).
        // CHAIN KEY: kb is the key for bob_send<succ(succ(i))> (kb_g := kb).
        Some(bob_recv_out<succ(i)>(bob_state<succ(i)>(kss, gae, rb, rb', ra', rb', bk2, a3), kss, kb, kb, m, ka, ka))
      }
    }
  } otherwise None()

// Alice receives Bob's round-succ(i) message and performs her round-succ(i)
// step. She holds the root key after her own round-i step.
//   ak2 : her fresh ratchet key a<succ(succ(i))>.
def alice_recv_succ<i>(st: alice_state<idx i>, ak2: Name(a<succ(succ(i))>), ika: dhpk(long_skA)) @ alice: Option alice_recv_out<succ(i)> =
  // PROVENANCE, two levels: Alice's root key is her LA<i> step over her
  // recomputation of Bob's LB<i> step, both against the share wpk received
  // in the previous receive def.
  parse st as alice_state<idx i>(kss, wpk, wsalt2, ra_g, wsalt, ra, ak1, b3) in
  input i2, _ in
  parse i2 as signal_message(gbe, ctr, prev, ctxt, addr) in {
    guard is_group_elem(gbe) in
    pcase chain_a<i>[kss] in
    pcase sec(a<succ(i)>) in
    pcase sec(b<succ(i)>) in
    pcase gbe == dhpk(get(b<succ(i)>)) in
    // PROVENANCE: does Alice hold the honest chain name? (If so and it is
    // corrupt, this is the ODH "healing" case.)
    pcase ra_g == get(KDF<LA<i>(kss); kdfkey || enckey; 0>) in
    cross_dh_lemma<a<succ(i)>>(gbe);
    cross_dh_lemma<a<succ(i)>>(wpk);
    kdf_label_lemma<KDF<LA<i>(kss); kdfkey || enckey; 0>>();
    kdf_label_lemma<KDF<LB<succ(i)>(kss); kdfkey || enckey; 0>>();
    kdf_label_lemma<KDF<LA<succ(i)>(kss); kdfkey || enckey; 0>>();
    false_elim in

    // ra is public or a chain name: it is not a secret chain name of another step.
    forall j:idx { forall k:bv { secret_neq_lemma(ra, get(KDF<LA<j>(k); kdfkey || enckey; 0>)) } };
    forall j:idx { forall k:bv { secret_neq_lemma(ra, get(KDF<LB<j>(k); kdfkey || enckey; 0>)) } };
    // Bob's step of round succ(i), recomputed by Alice
    let s_b = dh_combine<name b<succ(i)>, name a<succ(i)>>(gbe, ak1) in
    // s_b is not a KEM secret (for the parameter of the _bad rule)
    forall j:idx { dh_exp_lemma<a<succ(i)>, KEMName<pqbo, j>>(gbe) };
    let rb' = kdf<LB<succ(i)>(kss), LB_bad<succ(i)>(s_b, kss); kdfkey || enckey; 0>(ra, s_b, 0x5768697370657252617463686574) in
    let kb  = kdf<LB<succ(i)>(kss), LB_bad<succ(i)>(s_b, kss); kdfkey || enckey; 1>(ra, s_b, 0x5768697370657252617463686574) in

    let N_c = get_counter N_c_alice in
    let mb_opt = st_aead_dec(kb, ctxt, b3 ++ ika ++ gbe ++ ctr ++ prev ++ addr, N_c) in
    case mb_opt {
      | None => None()
      | Some m => {
        // PROVEN [P3]: agreement and key authenticity under a secret incoming root key
        assert ((ra_g == get(KDF<LA<i>(kss); kdfkey || enckey; 0>) /\ chain_a<i>[kss]) ==> happened(bob_sent<succ(i)>(m)));
        assert ((ra_g == get(KDF<LA<i>(kss); kdfkey || enckey; 0>) /\ chain_a<i>[kss]) ==> gbe == dhpk(get(b<succ(i)>)));
        // Alice's step of round succ(i): fresh a<succ(succ(i))> against b<succ(i)>
        pcase sec(a<succ(succ(i))>) in
        cross_dh_lemma<a<succ(succ(i))>>(gbe);
        false_elim in
        // rb' is public or a chain name: it is not a secret chain name of another step.
        forall j:idx { forall k:bv { secret_neq_lemma(rb', get(KDF<LA<j>(k); kdfkey || enckey; 0>)) } };
        forall j:idx { forall k:bv { secret_neq_lemma(rb', get(KDF<LB<j>(k); kdfkey || enckey; 0>)) } };
        let s_a = dh_combine<name b<succ(i)>, name a<succ(succ(i))>>(gbe, ak2) in
        // s_a is not a KEM secret (for the parameter of the _bad rule)
        forall j:idx { dh_exp_lemma<a<succ(succ(i))>, KEMName<pqbo, j>>(gbe) };
        let ra' = kdf<LA<succ(i)>(kss), LA_bad<succ(i)>(s_a, kss); kdfkey || enckey; 0>(rb', s_a, 0x5768697370657252617463686574) in
        let ka  = kdf<LA<succ(i)>(kss), LA_bad<succ(i)>(s_a, kss); kdfkey || enckey; 1>(rb', s_a, 0x5768697370657252617463686574) in

        // PROVEN [P2]: local "post-compromise security" for the recovery case:
        // if we had a bad root key, but this round's DH keys are both secret,
        // then the next round's root key is secret again.
        assert(
          !chain_a<i>[kss]
          /\ (sec(a<succ(i)>) /\ sec(b<succ(i)>))
            ==> chain_a<succ(i)>[kss]
        );

        // PROVENANCE: ra' is Alice's state for alice_recv_succ<succ(i)>
        // (wpk := gbe, wsalt2 := ra, ra_g := ra', wsalt := rb', ak := ak2).
        // CHAIN KEY: ka is the key for alice_send<succ(i)> (ka_g := ka).
        Some(alice_recv_out<succ(i)>(alice_state<succ(i)>(kss, gbe, ra, ra', rb', ra', ak2, b3), kss, ka, ka, m, kb, kb))
      }
    }
  } otherwise None()

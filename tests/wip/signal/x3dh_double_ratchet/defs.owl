/*

Shared declarations of the Signal model: X3DH (x3dh.owl) followed by the
double ratchet (double_ratchet.owl). full.owl checks both.

The two protocols share one KDF scope, because Signal's key schedule is one
KDF chain. X3DH's root key RK_1 = KDF<LA_init; ..; 0> is the salt of Bob's
first ratchet step LB<0>, and Alice's first ratchet key a<0> is a DH key of
both LA_init (with Bob's signed prekey bs) and LB<0> (with b<0>). A rule may
only have keys of its own scope in key positions, so these rules cannot be
put in two scopes.

Link. alice_x3dh ends by calling alice_recv_0 with RK_1, and bob_x3dh ends by
calling bob_send_0 with RK_1 and Alice's ratchet key. Bob's first ratchet
message (mb<0>, under LB<0>) is sent by bob_send_0. The parameter types of
these two defs (below) are the interface between the protocols.

*/

locality alice
locality bob

// X3DH: Alice's first message (sent with her initial ratchet step)
counter N_c @ alice
// Double ratchet
counter N_c_alice @ alice
counter N_c_bob   @ bob

// ---------- NAMES OUTSIDE THE KDF SCOPE --------------------------------------

name ma1 : nonce @ alice // Alice's first message (X3DH)
name ma2 : nonce @ alice // Alice's second message (currently unused)

// Double ratchet plaintext secrets, one per round and direction. mb<0> is
// Bob's first ratchet message, sent in reply to the X3DH handshake.
name mb<i> : nonce @ bob    // Bob's message in round i
name ma<i> : nonce @ alice  // Alice's message in round i

// ---------- EVENTS ------------------------------------------------------------

def event_alice_send_msg1 @ alice
def event_bob_recv_msg1 @ bob

// The sender records its plaintext before encrypting; the receiver asserts
// the event after a successful decryption.
def bob_sent<i> @ bob
def alice_sent<i> @ alice

kdf_scope Signal {

    // ---------- X3DH -----------------------------------------------------------

    // Alice's DH keys
    name long_skA : DH @ alice // Alice's long-term DH key (never changes)
    name ae1 : DH @ alice      // Alice's ephemeral DH key (changes per connection)

    // Bob's DH keys
    name long_skB : DH @ bob   // Bob's long-term DH key (never changes)
    name bs : DH @ bob         // Bob's ephemeral signed DH key (one per set of bo)
    name bo : DH @ bob         // Bob's ephemeral one-time DH key

    // ---------- DOUBLE RATCHET ---------------------------------------------------

    // Ratchet DH keys. a<0> is Alice's ratchet key in the X3DH initial
    // message; a<succ(i)> is generated by Alice in round i, b<i> by Bob in
    // round i.
    name a<i> : DH @ alice
    name b<i> : DH @ bob

    // ---------- X3DH HELPER FUNCTIONS AND PREDICATES ---------------------------

    func correct_amaster_arg() =
        dh_combine(dhpk(get(bs)), get(long_skA))
        ++ dh_combine(dhpk(get(long_skB)), get(ae1))
        ++ dh_combine(dhpk(get(bs)), get(ae1))
        ++ dh_combine(dhpk(get(bo)), get(ae1))

    func correct_bmaster_arg() =
        dh_combine(dhpk(get(long_skA)), get(bs))
        ++ dh_combine(dhpk(get(ae1)), get(long_skB))
        ++ dh_combine(dhpk(get(ae1)), get(bs))
        ++ dh_combine(dhpk(get(ae1)), get(bo))

    predicate bob_good(dh) =
      dh == correct_bmaster_arg()
      /\
      // the adversary cannot compute the master secret iff some DH pair has
      // both keys secret
      ((sec(bs) /\ sec(long_skA)) \/ (sec(long_skB) /\ sec(ae1))
        \/ (sec(bs) /\ sec(ae1)) \/ (sec(bo) /\ sec(ae1)))



    // AEAD nametype for Alice's first message, keyed under the split of amaster
    // TODO: AEAD encryption in Signal contains a KDF inside of the encryption to
    // produce the IV. See https://signal.org/docs/specifications/doubleratchet/#recommended-cryptographic-algorithms
    nametype ma1_enc(dh) = st_aead Name(ma1) //(if dh == correct_amaster_arg() then Name(ma1) else (x:Name(ma1){False}))
          aad x.
            // AD = IK_A || IK_B, as in X3DH
            ((x == dhpk(get(long_skA)) ++ dhpk(get(long_skB)))
              /\ happened(event_alice_send_msg1(get(ma1), dh, x)))
          nonce N_c

    // nametype ma1_enc = st_aead Name(ma1)
    //       aad x. (x == (dhpk(get(ae1)) ++ dhpk(get(long_skA)) ++ dhpk(get(a<0>))))
    //       nonce N_c

    // nametype ma1_corr = st_aead (y:Name(ma1){False})
    //       aad x. true
    //       nonce N_c

    // ODH rule for the master key derivation.
    odh L1 : 0x, dh_ss(bs, long_skA) ++ dh_ss(long_skB, ae1) ++ dh_ss(bs, ae1) ++ dh_ss(bo, ae1), 0x -> strict kdfkey
    // Off-chain rules. A rule instance applies only when some honest DH
    // atom of its ikm has both keys secret; the checker adds that condition
    // itself. Otherwise every atom is adversary-computable, the call is out
    // of bounds of every rule, and the checker types it public.
    //
    // Alice with a forged one-time prekey y (honest s1, s2, s3).
    odh L1_badA(y) where
        (is_group_elem(y) /\ y != dhpk(get(bo)))
      : 0x, dh_ss(bs, long_skA) ++ dh_ss(long_skB, ae1) ++ dh_ss(bs, ae1) ++ dh_combine(y, get(ae1)), 0x -> strict kdfkey
    // Bob with a forged ephemeral x for Alice (honest s1).
    odh L1_badB(x) where
        (is_group_elem(x) /\ x != dhpk(get(ae1)))
      : 0x, dh_ss(bs, long_skA) ++ dh_combine(x, get(long_skB)) ++ dh_combine(x, get(bs)) ++ dh_combine(x, get(bo)), 0x -> strict kdfkey

    // AEAD nametype for a key that no honest party encrypts under (derived
    // by a _bad rule from a forged ratchet key): decryption can only fail.
    nametype ma1_corr = st_aead (y:Name(ma1){False})
          aad x. true
          nonce N_c

    // Alice's initial ratchet step ([DR] 3.3, 7.1): RK_1 || CK_A =
    // KDF_RK(SK, DH(a<0>, bs)). Bob's signed prekey bs is his initial ratchet
    // key, so bs occurs in two ODH rules (L1 and LA_init); the rules are
    // disjoint by salt (0x versus the derived SK). Output 0 is RK_1, the
    // root key that enters the double ratchet (salt of Bob's first step
    // LB<0>); output 1 is the AEAD key for Alice's initial message
    // (Signal's KDF_CK and message-key HKDF are folded into the AEAD
    // abstraction: one message per chain).
    odh LA_init : KDF<L1;kdfkey;0>, dh_ss(a<0>, bs), 0x -> strict kdfkey || strict ma1_enc(correct_amaster_arg())
    // Alice with a forged one-time prekey y (SK from L1_badA).
    odh LA_init_badA(y) where
        (is_group_elem(y) /\ y != dhpk(get(bo)))
      : KDF<L1_badA(y);kdfkey;0>, dh_ss(a<0>, bs), 0x -> strict kdfkey
        || strict ma1_enc(dh_combine(dhpk(get(bs)), get(long_skA)) ++ dh_combine(dhpk(get(long_skB)), get(ae1)) ++ dh_combine(dhpk(get(bs)), get(ae1)) ++ dh_combine(y, get(ae1)))
    // Bob with a forged ephemeral x for Alice (SK from L1_badB) and Alice's
    // honest ratchet key.
    // Alice never derives this key (her ephemeral is ae1), so no honest party
    // encrypts under it.
    odh LA_init_badB(x) where
        (is_group_elem(x) /\ x != dhpk(get(ae1)))
      : KDF<L1_badB(x);kdfkey;0>, dh_ss(a<0>, bs), 0x -> strict kdfkey || strict ma1_corr
    // Bob with a forged ratchet key z for Alice (honest SK).
    odh LA_init_badR(z) where
        (is_group_elem(z) /\ z != dhpk(get(a<0>)))
      : KDF<L1;kdfkey;0>, dh_combine(z, get(bs)), 0x -> strict kdfkey || strict ma1_corr
    // Bob with a forged ephemeral x and a forged ratchet key z. Needed so
    // that, when SK is a secret off-chain name (honest bs and long_skA),
    // Bob's key is a name no honest party encrypts under and a successful
    // decryption is contradictory; typed public, the branch would go on to
    // encrypt mb<0> under a public key.
    odh LA_init_badBR(x, z) where
        (is_group_elem(x) /\ x != dhpk(get(ae1)) /\ is_group_elem(z) /\ z != dhpk(get(a<0>)))
      : KDF<L1_badB(x);kdfkey;0>, dh_combine(z, get(bs)), 0x -> strict kdfkey || strict ma1_corr

    // ---------- DOUBLE RATCHET RULES -------------------------------------------

    // AEAD nametypes for Bob's round-i message
    nametype mb_enc<i> = st_aead (m:Name(mb<i>){happened(bob_sent<i>(m))})
          aad x. (x == dhpk(get(long_skA)) ++ dhpk(get(long_skB)))
          nonce N_c_bob
    nametype mb_corr<i> = st_aead (y:Name(mb<i>){False})
          aad x. true
          nonce N_c_bob

    // AEAD nametypes for Alice's round-i message (carries her next key)
    nametype ma_enc<i> = st_aead (m:Name(ma<i>){happened(alice_sent<i>(m))})
          aad x. (x == dhpk(get(long_skA)) ++ dhpk(get(long_skB)))
          nonce N_c_alice
    nametype ma_corr<i> = st_aead (y:Name(ma<i>){False})
          aad x. true
          nonce N_c_alice

    // Bob's step ([DR] 3.5). Output 0 = chain key; 1 = Bob's AEAD key.
    // Round 0 is salted by X3DH's root key RK_1 (rule LA_init) and uses
    // Alice's X3DH ratchet key a<0>.
    rec_odh<i> LB<i>
        | 0        : KDF<LA_init; kdfkey || enckey; 0>, dh_ss(a<0>, b<0>), 0x
        | succ(i') : KDF<LA<i'>; kdfkey || enckey; 0>,  dh_ss(a<i>, b<i>), 0x
        -> strict kdfkey || strict mb_enc<i>

    rec_odh<i> LB_bad<i>(s) where (s != dh_combine(dhpk(get(a<i>)), get(b<i>)))
        | 0        : KDF<LA_init; kdfkey || enckey; 0>, s, 0x
        | succ(i') : KDF<LA<i'>; kdfkey || enckey; 0>,  s, 0x
        -> strict kdfkey || strict mb_corr<i>

    // Alice's step. Output 0 = chain key; 1 = Alice's AEAD key.
    // Her fresh key in round i is a<succ(i)>; a<succ(i')> = a<i> is the key
    // Bob already used in LB<i>. LA never uses i': its salt LB<i> is from the
    // same round, so both cases have the same form.
    rec_odh<i> LA<i>
        | 0        : KDF<LB<0>; kdfkey || enckey; 0>,   dh_ss(a<succ(0)>, b<0>), 0x
        | succ(i') : KDF<LB<i>; kdfkey || enckey; 0>,   dh_ss(a<succ(i)>, b<i>), 0x
        -> strict kdfkey || strict ma_enc<i>

    rec_odh<i> LA_bad<i>(s) where (s != dh_combine(dhpk(get(a<succ(i)>)), get(b<i>)))
        | 0        : KDF<LB<0>; kdfkey || enckey; 0>,   s, 0x
        | succ(i') : KDF<LB<i>; kdfkey || enckey; 0>,   s, 0x
        -> strict kdfkey || strict ma_corr<i>
}

// Bob's long-term signing key (signs bs for the prekey bundle)
// In Signal, long_sskB and long_skB are the SAME byte sequence (x25519 used for
// both signing and DH). Their corruption is therefore linked via corr below.
name long_sskB : sigkey(dhpk(bs)) @ bob

// ---------- CORRUPTION ASSUMPTIONS --------------------------------------------

// In Signal, long_sskA and long_skA are the SAME byte sequence! because signal
// uses x25519 keys for both signing and DH. So their corruption must be linked.
// corr [long_sskA] ==> [long_skA]
// corr [long_skA] ==> [long_sskA]
// ae1 is unsigned in the handshake. Impersonation of Alice with a stolen
// long_skA is handled on Bob's side by the split on a1 == dhpk(get(ae1)) and
// the L1_badB rules, not by a flow corr [long_skA] ==> [ae1]: that flow would
// discard the guarantee X3DH gives when Alice's long-term key is
// compromised but her ephemeral is honest (SK protected by DH2 and DH3).
corr [long_sskB] ==> [long_skB]
corr [long_skB] ==> [long_sskB]

// No other corr flows: the labels of RK_1 and of every ratchet chain key
// follow from the applicability of their rule instances. The handshake
// messages ma1 and mb<0> need no flows either: they are secret in every good
// session (alice_msg1_good, bob_msg0_good), and the model makes no claim about
// them in other sessions.

// ---------- STRUCTS -----------------------------------------------------------

// X3DH

struct bob_prekey_msg {
  _b1: dhpk(bo),
  _b2: dhpk(bs),
  _b3: dhpk(long_skB),
  _b4: Data<adv> ||signature||
}

struct alice_prekey_msg {
  _a1: dhpk(ae1),
  _a2: dhpk(long_skA),
  _a3: Data<adv>,
  _a4: dhpk(a<0>) // Alice's public key for the first round of double ratchet
}

// Double ratchet

struct bob_message<i> {
  _b_pk: dhpk(b<i>),
  _b_ctxt: Data<adv>
}

struct alice_message<i> {
  _a_pk: dhpk(a<succ(i)>),
  _a_ctxt: Data<adv>
}

// ---------- PREDICATES --------------------------------------------------------

// The chain key after Bob's / Alice's step of round i is secret
predicate chain_b<i>() = sec(KDF<LB<i>; kdfkey || enckey; 0>)
predicate chain_a<i>() = sec(KDF<LA<i>; kdfkey || enckey; 0>)

// GOOD SESSIONS for the two handshake messages. Alice's message key ka is an
// honest key and secret: the on-chain key, or the key for a forged one-time
// prekey y (LA_init_badA). With long_skB corrupt, an adversary can forge Bob's
// whole bundle; Alice's key is then a public value and the session is not good.
predicate alice_msg1_good(ka, y) =
    (ka == get(KDF<LA_init; kdfkey || enckey; 1>) /\ sec(KDF<LA_init; kdfkey || enckey; 1>))
    \/ (is_group_elem(y) /\ y != dhpk(get(bo))
        /\ ka == get(KDF<LA_init_badA(y); kdfkey || enckey; 1>)
        /\ sec(KDF<LA_init_badA(y); kdfkey || enckey; 1>))
// Bob's round-0 message key is the honest one and secret: his root key is the
// honest RK_1, Alice's ratchet key gae is honest, and the key derived from
// them is secret. Bob cannot authenticate Alice's ephemeral, so with bs or
// long_skA corrupt an adversary can make Bob's root key a public value.
predicate bob_msg0_good(rb_g, gae) =
    rb_g == get(KDF<LA_init; kdfkey || enckey; 0>) /\ gae == dhpk(get(a<0>))
    /\ sec(KDF<LB<0>; kdfkey || enckey; 1>)

// ---------- INTERFACE: X3DH -> DOUBLE RATCHET ---------------------------------

// Bob's first send, called by bob_x3dh after it has decrypted Alice's
// initial message.
//   bdh, bm  : Bob's X3DH DH input and master secret SK (ghost).
//   rb_g, rb : Bob's root key RK_1 = KDF_RK(SK, DH(gae, bs)). It is the
//              honest root key KDF<LA_init;..;0> when that key is secret;
//              otherwise it is public, with this provenance.
//   gae      : Alice's ratchet key as Bob received it. It is her honest
//              a<0> whenever Bob holds the honest secret root key (X3DH
//              authenticates it through the AAD of Alice's initial message).
//   pt       : Bob's round-0 plaintext; secret only when Bob holds the
//              honest message key and it is secret.
def bob_send_0(
  bdh: Ghost,
  bm: (x:Ghost{ x == gkdf<kdfkey; 0>(0x, bdh, 0x) }),
  rb_g: Ghost,
  gae: (x:Data<adv> ||group||{
          (rb_g == get(KDF<LA_init; kdfkey || enckey; 0>) /\ sec(KDF<LA_init; kdfkey || enckey; 0>))
            ==> x == dhpk(get(a<0>)) }),
  rb: if rb_g == get(KDF<LA_init; kdfkey || enckey; 0>) /\ sec(KDF<LA_init; kdfkey || enckey; 0>)
      then Name(KDF<LA_init; kdfkey || enckey; 0>)
      else (x:Data<adv> ||kdfkey||{ x == rb_g /\ x == gkdf<kdfkey || enckey; 0>(bm, dh_combine(gae, get(bs)), 0x) }),
  a3: dhpk(long_skA),
  pt: if bob_msg0_good[rb_g, gae] then Name(mb<0>) else Data<adv>
) @ bob: Option Unit

// Alice's first receive, called by alice_x3dh after it has sent her initial
// message.
//   adh, am  : Alice's X3DH DH input and master secret SK (ghost).
//   ags      : Bob's signed prekey as Alice received it (ghost).
//   ra_g, ra : Alice's root key RK_1 = KDF_RK(SK, DH(ags, a<0>)): the honest
//              KDF<LA_init;..;0>, the off-chain root key of a session with
//              a forged one-time prekey ra_y (LA_init_badA), or public, with
//              this provenance.
def alice_recv_0(
  adh: Ghost,
  am: (x:Ghost{ x == gkdf<kdfkey; 0>(0x, adh, 0x) }),
  ags: Ghost,
  ra_g: Ghost,
  ra_y: Ghost,
  ra: if ra_g == get(KDF<LA_init; kdfkey || enckey; 0>) then Name(KDF<LA_init; kdfkey || enckey; 0>)
      else if is_group_elem(ra_y) /\ ra_y != dhpk(get(bo))
              /\ ra_g == get(KDF<LA_init_badA(ra_y); kdfkey || enckey; 0>)
      then Name(KDF<LA_init_badA(ra_y); kdfkey || enckey; 0>)
      else (x:Data<adv> ||kdfkey||{ x == ra_g /\ x == gkdf<kdfkey || enckey; 0>(am, dh_combine(ags, get(a<0>)), 0x) }),
  b3: dhpk(long_skB)
) @ alice: Option Unit

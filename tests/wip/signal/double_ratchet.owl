//     | i = 0 : something_from_the_handshake, dh_combine(alice_dh<0>, bob_dh<0>) -> strict ratchet<1> || strict mb1_enc
//     | KDF<ratchet<i-1>;kdfkey;0> , dh_combine(alice_dh<i>, bob_dh<i>) ->

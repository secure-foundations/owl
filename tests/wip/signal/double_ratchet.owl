/*

Alice                            Bob
        alice_pk_i=dhpk(ark_i)
        ctxt_i
ark_i   ------------------->    brk_i
                               enckey_i+1 || rk_i+1 = kdf(rk_i, dh_combine(alice_pk_i, brk_i), 0x)
                               plaintext_i = aead_decrypt(enckey_i+1, ctxt_i, aad contains alice_pk_i and i)


Need an off-chain ODH. 3 cases
1. a == dhpk(ark_i)
2. a == some other valid dhpk ---> off-chain case
3. a is not a valid dhpk ---> should be ruled out by AEAD (?)


sec(rk_i) ==> sec(enckey_i+1) ==> aead_decrypt succeeds ==> alice_pk_i must have been authentic
                                       ===> sec(rk_i+1)

*/

locality alice
locality bob

name long_skA : DH @ alice // Alice's long-term DH key (never changes)
name long_skB : DH @ bob // Bob's long-term DH key (never changes)

counter N_c_alice @ alice
counter N_c_bob @ bob

// ---------- DOUBLE RATCHET ROUND 3 ------------

name ae3: DH @ alice // ephemeral 
name be3: DH @ bob // ephemeral

name ma3: nonce @ alice // Alice's first ratchet message


nametype mb3_enc = st_aead Name(ma3)
      aad x. (x == dhpk(get(ae3)) ++ dhpk(get(long_skA)))
      nonce N_c_alice

nametype mb3_corr = st_aead (x: Name(ma3){False})
      aad x. True
      nonce N_c_alice



// This is the output of the X3DH handshake, which is the input to the first round
// of double ratchet

nametype r3 = kdf { ikm info. 
  True -> strict nonce /* TODO: r4 */ || strict nonce /* TODO: mb4_enc */
}

nametype r3_corr = kdf { ikm info. 
  True -> strict nonce /* TODO: r4_corr */ || strict nonce /* TODO: mb4_enc */
}

// ---------- DOUBLE RATCHET ROUND 2 ------------

name ae2: DH @ alice // ephemeral 
name be2: DH @ bob // ephemeral

name mb2: nonce @ bob // Bob's first ratchet message


nametype mb2_enc = st_aead Name(mb2)
      aad x. (x == dhpk(get(be2)) ++ dhpk(get(long_skB)))
      nonce N_c_bob

nametype mb2_corr = st_aead (x: Name(mb2){False})
      aad x. True
      nonce N_c_bob

nametype r2_corr = kdf { ikm info. 
  True -> strict r3_corr || strict mb3_corr
}

nametype r2 = kdf { ikm info. 
  ikm == dh_combine(dhpk(get(ae3)), get(be2)) -> strict r3 || strict mb3_enc,
  ikm != dh_combine(dhpk(get(ae3)), get(be2)) -> strict r3_corr || strict mb3_corr
}

odh LR2 : be2, ae3 ->
 {salt info self.
      True -> strict r3
              || 
              strict mb3_enc
 }


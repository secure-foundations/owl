// def bob_round<i>(state<i>: ...) : state<i+1> =
//   send || recv;
//   re-ratchet


// ----------- DOUBLE RATCHET ROUND 1 ------------
// Double ratchet round 1 is encoded in the handshake

// This is the output of the X3DH handshake, which is the input to the first round
// of double ratchet
name r1 : kdf { ikm info. 
  ikm == dh_combine(dhpk(get(ae2)), get(be2)) -> strict r2 || strict mb2_enc,
  ikm != dh_combine(dhpk(get(ae2)), get(be2)) -> strict r2_corr || strict mb2_corr
}

odh LR1 : ae2, be2 ->
 {salt info self.
      True -> strict r2
              || 
              strict mb2_enc
 }



// ------------ CORR AXIOMS ------------

// These encode the relationship between long-term keys and the ratchet key that
// comes from the handshake
corr [long_skA] ==> [r1]
corr [long_skB] ==> [r1]


// corr [ae2] /\ [long_skA] ==> [mb2]
// corr [be2] /\ [long_skB] ==> [mb2]

corr [r1] /\ [ae2] /\ [be2] ==> [mb2]
// corr [r1] /\ [be2] ==> [mb2]

// TODO: should be r2 instead of r1
corr [r1] /\ [ae2] /\ [ae3] /\ [be2] ==> [ma3]


// corr [ae2] ==> [be2]
// corr [be2] ==> [ae2]
// These are used to express that dh_combine is public if EITHER input name is public
// Owl doesn't always derive this if it can't syntactically infer the dh_combine args
// to be dhpk and name
corr [r1] /\ [ae2] ==> [be2] // TODO: this is too strong
corr [r1] /\ [be2] ==> [ae2] // TODO: this is too strong

// ------------ Cleanliness predicates ------------

predicate bob_good() = sec(long_skB) \/ sec(long_skA)


struct alice_message2 {
  _a_pk: dhpk(ae3),
  _a_ctxt: Data<adv>
}

struct bob_message1 {
  _b5: dhpk(be2),
  _b6: Data<adv>
}


// def bob_round<i>(state<i>: ...) : state<i+1> =
//   send || recv;
//   re-ratchet

// ------------ CORR AXIOMS (verbatim from original) ------------

// These encode the relationship between long-term keys and the ratchet key that
// comes from the handshake
corr [long_skA] ==> [r1]
corr [long_skB] ==> [r1]
corr [r1] ==> [ae2] // r1 is derived from the handshake, and the handshake AEAD guarantees authenticity of ae2

corr [r1] /\ [ae2] /\ [be2] ==> [mb2]

// TODO: should be r2 instead of r1
corr [r1] /\ [be2] /\ [ae3] ==> [ma3]

corr [r1] /\ [ae2] ==> [be2] // TODO: this is too strong

corr [be2] ==> [ma3]
corr [ae3] ==> [ma3]


// ------------ STRUCTS ------------

struct alice_message2 {
  _a_pk: dhpk(ae3),
  _a_ctxt: Data<adv>
}

struct bob_message1 {
  _b5: dhpk(be2),
  _b6: Data<adv>
}



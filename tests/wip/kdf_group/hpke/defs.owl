// The parties of the protocol
locality sender
locality receiver

// Similar to how we encode WireGuard, this channel_secret nonce is used to
// define the information flow label of secret data flowing from sender to
// receiver after the handshake.
name channel_secret : nonce

def sent_message @ sender
type plaintext_t = (x:Data<[channel_secret] /\ adv, |adv|>{happened(sent_message(x))})



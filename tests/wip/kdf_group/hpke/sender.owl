include "defs.owl"


struct AuthEncapResult<i> {
    // If one of the two DH shared secrets are actually secret, then we get the
    // correct, secret output; otherwise public output
    aer_shared_secret : if sec(HPKE_KDF.skR) /\ (sec(HPKE_KDF.skS) \/ sec(HPKE_KDF.skE<i>)) then
        SecName(KDF<HPKE_KDF.L_kem<i>(lbl_info(kem_suite_id(), kdfkey_len(), shared_secret_string(), AuthEncap_kem_context<session i>())); kdfkey; 0>(0x,
        lbl_ikm(kem_suite_id(), eae_prk(), AuthEncap_dh<session i>()),
        lbl_info(kem_suite_id(), kdfkey_len(), shared_secret_string(), AuthEncap_kem_context<session i>())))
        else
            (x:Data<adv> ||kdfkey|| {
                x == AuthEncap_shared_secret<session i>()}),
    aer_pke : dhpk(HPKE_KDF.skE<i>)
}

/* Corresponds 1-1 with AuthEncap in RFC */
def AuthEncap<i>(pkR : dhpk(HPKE_KDF.skR), dhpk_skE: dhpk(HPKE_KDF.skE<i>), dhpk_skS: dhpk(HPKE_KDF.skS)) @ sender : AuthEncapResult<session i> =
    let dh = dh_combine(pkR, get(HPKE_KDF.skE<i>)) ++ dh_combine(pkR, get(HPKE_KDF.skS))  in
    let kem_context = dhpk_skE ++ pkR ++ dhpk_skS in
    let shared_secret = kdf<HPKE_KDF.L_kem<i>(lbl_info(kem_suite_id(), kdfkey_len(), shared_secret_string(), kem_context)); kdfkey; 0>(
                            0x,
                            lbl_ikm(kem_suite_id(), eae_prk(), dh), 
                            lbl_info(kem_suite_id(), kdfkey_len(), shared_secret_string(), kem_context)) 
    in
    let res :   if sec(HPKE_KDF.skR) /\ (sec(HPKE_KDF.skS) \/ sec(HPKE_KDF.skE<i>)) then
        SecName(KDF<HPKE_KDF.L_kem<i>(lbl_info(kem_suite_id(), kdfkey_len(), shared_secret_string(), AuthEncap_kem_context<session i>())); kdfkey; 0>(0x,
        lbl_ikm(kem_suite_id(), eae_prk(), AuthEncap_dh<session i>()),
        lbl_info(kem_suite_id(), kdfkey_len(), shared_secret_string(), AuthEncap_kem_context<session i>())))
        else
            Data<adv> ||kdfkey||
            = shared_secret in
    AuthEncapResult<session i>(res, dhpk_skE)


/* Corresponds to Context<ROLE> for the Sender from the RFC */
struct ContextS<i> {
        // Shared secret value (in ghost)
        ctxtS_ss : (x:Ghost{x == AuthEncap_shared_secret<session i>()}),
        // Base nonce. Only guaranteed to be correct if psk is secret,
        // OR one of the DH shared secrets are fully secret
        ctxtS_base : if sec(HPKE_KDF.psk) \/ (sec(HPKE_KDF.skR) /\ (sec(HPKE_KDF.skS) \/ sec(HPKE_KDF.skE<i>)))
            then PubName(KDF<HPKE_KDF.L_sched_nonce; nonce |counter|; 0>(ctxtS_ss,
            dh_secret_kdf_ikm(get(HPKE_KDF.psk)), base_nonce_kdf_info()))
            else Data<adv>,
        // Secret key. Same correctness guarantee as the base nonce
        ctxtS_sk :
        if sec(HPKE_KDF.psk) \/ (sec(HPKE_KDF.skR) /\ (sec(HPKE_KDF.skS) \/ sec(HPKE_KDF.skE<i>)))
            then SecName(KDF<HPKE_KDF.L_sched_key; enckey; 0>(ctxtS_ss,
            dh_secret_kdf_ikm(get(HPKE_KDF.psk)), key_kdf_info()))
            else Data<adv>,
        // Export key. Same correctness guarantee as the base nonce
        ctxtS_export :
        if sec(HPKE_KDF.psk) \/ (sec(HPKE_KDF.skR) /\ (sec(HPKE_KDF.skS) \/ sec(HPKE_KDF.skE<i>)))
            then SecName(KDF<HPKE_KDF.L_sched_export; nonce; 0>(ctxtS_ss,
            dh_secret_kdf_ikm(get(HPKE_KDF.psk)), export_kdf_info()))
            else Data<adv>
}

def KeyScheduleS<i>(aer : AuthEncapResult<session i>) @ sender : ContextS<session i> =
    parse aer as AuthEncapResult<session i>(shared_secret, pkE) in
    let base_nonce = kdf<HPKE_KDF.L_sched_nonce; nonce |counter|; 0>(shared_secret,
    dh_secret_kdf_ikm(get(HPKE_KDF.psk)), base_nonce_kdf_info()) in
    let sk = kdf<HPKE_KDF.L_sched_key; enckey; 0>(shared_secret, dh_secret_kdf_ikm(get(HPKE_KDF.psk)), key_kdf_info()) in
    let exp = kdf<HPKE_KDF.L_sched_export; nonce; 0>(shared_secret, dh_secret_kdf_ikm(get(HPKE_KDF.psk)), export_kdf_info()) in
    ContextS<session i>(shared_secret, base_nonce, sk, exp)

def sent_message(x : Ghost) @ sender : Unit = ()

def Seal<i>(ctxt : ContextS<session i>, x : Data<[channel_secret] /\ adv, |adv|>) @ sender : Data<adv> =
    parse ctxt as ContextS<session i>(_, base, sk, _) in
    call sent_message(x);
    st_aead_enc<send_counter<i>, pattern i. xor(i, base)>(sk, x, 0x)

def SingleShotSeal<i>(pkR : dhpk(HPKE_KDF.skR), dhpk_skE: dhpk(HPKE_KDF.skE<i>), dhpk_skS: dhpk(HPKE_KDF.skS), x : Data<[channel_secret] /\ adv, |adv|>) @ sender : Unit =
    let aer = call AuthEncap<i>(pkR, dhpk_skE, dhpk_skS) in
    let context = call KeyScheduleS<i>(aer) in
    let c = call Seal<i>(context, x) in
    parse aer as AuthEncapResult<session i>(_, pk) in
    output hpke_ciphertext(pk, c) to endpoint(receiver)

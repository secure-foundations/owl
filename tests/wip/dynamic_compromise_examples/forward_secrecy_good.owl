locality alice
locality bob

name alice_eph: DH @ alice
name bob_eph: DH @ bob

struct pubkeys {
    _pkA: Data<adv> ||group||, // dhpk(alice_eph),
    _pkB: dhpk(bob_eph)
}

// name bob_sigkey : sigkey pubkeys @ bob
name bob_sigkey : sigkey dhpk(bob_eph) @ bob

name channel_secret : nonce @ alice, bob // lattice point for messages

odh L : alice_eph, bob_eph -> 
    {salt info.
        True -> strict enckey Name(channel_secret)
    }

struct bob_msg {
    _bob_pk: dhpk(bob_eph),
    _bob_sig: Data<adv> ||signature||
}

// Clean session for Alice
predicate alice_clean() =
    sec(alice_eph) /\ sec(bob_eph)

// Clean session for Bob
predicate bob_clean(received_alice_pk) =
    received_alice_pk == dhpk(get(alice_eph)) /\ sec(bob_eph) /\ sec(alice_eph)

// Corruption scenarios
corr [alice_eph] ==> [channel_secret]
corr [bob_eph] ==> [channel_secret]
corr [bob_sigkey] ==> [channel_secret] /\ [bob_eph] /\ [alice_eph]

def alice_main() @ alice: Option Unit =
    let _ = output dhpk(get(alice_eph)) to endpoint(bob) in
    input bob_inpt in
    parse bob_inpt as bob_msg(bob_pk, bob_sig) in {
    corr_case bob_sigkey in
    // case vrfy(get_vk(bob_sigkey), pubkeys(dhpk(get(alice_eph)), bob_pk), bob_sig) {
    case vrfy(get_vk(bob_sigkey), bob_pk, bob_sig) {
    | Some pubkeys_msg => {
        // parse pubkeys_msg as pubkeys(pkA, pkB) in {
        // guard is_group_elem(pkA) in
        // guard is_group_elem(pkB) in        
        // guard eq(pkA, dhpk(get(alice_eph))) in
        // guard eq(pkB, bob_pk) in
        guard is_group_elem(pubkeys_msg) in
        guard eq(pubkeys_msg, bob_pk) in
        let ss = dh_combine(bob_pk, get(alice_eph)) in

        // SHOULD DELETE alice_eph HERE

        let k = kdf<;odh L[0];enckey;0>(0x, ss, 0x) in 

        // alice sends one message
        let c = aenc(k, get(channel_secret)) in
        let _ = output c to endpoint(bob) in

        // alice receives one message
        input c in 
        corr_case alice_eph in
        corr_case bob_eph in
        corr_case nameOf(k) in
        case adec(k, c) {
        | Some ptxt =>
            let _ = assert(alice_clean[] ==> ptxt == get(channel_secret)) in
            Some(())
        | None => None()
        }

        // } otherwise None()
    }
    | None => None()
    }
    } otherwise None()

def bob_main() @ bob: Option Unit =
    input alice_pk in
    guard is_group_elem(alice_pk) in
    pcase (alice_pk == dhpk(get(alice_eph))) in
    // let pubkeys_sig = sign(get(bob_sigkey), pubkeys(alice_pk, dhpk(get(bob_eph)))) in
    let pubkeys_sig = sign(get(bob_sigkey), dhpk(get(bob_eph))) in
    let bob_msg = bob_msg(dhpk(get(bob_eph)), pubkeys_sig) in
    let _ = output bob_msg to endpoint(alice) in
    let ss = dh_combine(alice_pk, get(bob_eph)) in

    // SHOULD DELETE bob_eph HERE

    let k = kdf<;odh L[0];enckey;0>(0x, ss, 0x) in
    
    // bob receives one message
    input c in 
    corr_case alice_eph in
    corr_case bob_eph in
    corr_case nameOf(k) in
    case adec(k, c) {
    | Some ptxt =>
        let _ = assert(bob_clean[alice_pk] ==> ptxt == get(channel_secret)) in

        // TODO: bob should be able to prove alice_pk == dhpk(get(alice_eph)) here
        // otherwise AEAD would fail. Do we need AAD for this?

        // bob sends one message
        let c = aenc(k, get(channel_secret)) in
        let _ = output c to endpoint(alice) in

        Some(())
    | None => None()
    }